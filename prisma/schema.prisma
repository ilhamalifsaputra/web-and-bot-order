  action     String
  targetType String?  @map("target_type")
  targetId   Int?     @map("target_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")
  /// "ADMIN" | "CUSTOMER" — who initiated this entry. Defaults to "ADMIN" so
  /// every existing row and every existing logAdminAction call site keeps
  /// working untouched (Phase H, customer-action audit trail).
  actorType      String   @default("ADMIN") @map("actor_type")
  /// "BOT" | "WEB" | null — surface the actor acted from; null for
  /// admin-side entries that predate this field or don't track it.
  channel        String?  @map("channel")
  customerId     Int?     @map("customer_id")
  telegramUserId BigInt?  @map("telegram_user_id")
  correlationId  String?  @map("correlation_id")

  admin    User? @relation(fields: [adminId], references: [id], onUpdate: NoAction)
  customer User? @relation("AuditLogCustomer", fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt], map: "ix_audit_logs_created_at")
