  trxId     String   @unique(map: "ix_processed_nowpayments_tx_trxid") @map("trx_id")
  orderId   Int?     @map("order_id")
  amount    Decimal?
  // matched | unmatched | delivery_failed | stale
  outcome   String
  createdAt DateTime @default(now()) @map("created_at")
  /// See ProcessedBinanceTx.updatedAt.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([orderId], map: "ix_processed_nowpayments_tx_order_id")
  @@map("processed_nowpayments_tx")
}

/// Records the amount actually received for a QRIS/IDR order (TokoPay,
/// PayDisini, NOWPayments) flagged UNDERPAID by markOrderUnderpaid
/// (packages/db/src/crud/orderStatus.ts). Unlike the crypto rails'
/// Processed*Tx ledgers, this is not a delivery-dedup table — these three
/// gateways dedupe via the order's own status (see markOrderUnderpaid's
/// doc comment) — it exists solely so findUnderpaidReceived (orders.ts)
/// can read back a structured amount instead of the adminNote free-text
/// note that was the only record before this table existed.
model QrisUnderpaidTx {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique @map("order_id")
  gateway        String
  receivedAmount Decimal  @map("received_amount")
  expectedAmount Decimal  @map("expected_amount")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("qris_underpaid_tx")
}

/// Idempotency ledger for Telegram update_id redelivery — same insert-first-
/// on-unique pattern as the Processed*Tx ledgers above, but for a different
/// kind of duplicate: Telegram's long-polling `getUpdates` offset only
/// advances once a batch is fully acknowledged, so a crash mid-processing
/// (before the next poll) — or a flaky connection — redelivers the same
/// update_id on restart/retry. `bindUpdateId` (apps/order-bot/src/middleware.ts)
/// claims a row here before running the rest of the update's middleware
/// chain, so a redelivered update short-circuits instead of re-running a
/// side effect (charging a wallet, sending a duplicate DM, ...) a second
/// time. Short-lived by design — unlike the payment ledgers above (which
/// storageMaintenance.ts deliberately leaves alone), a row here is only ever
/// useful for as long as Telegram might still redeliver the same update_id
/// (minutes, not months) — see pruneProcessedTelegramUpdates
/// (packages/db/src/crud/telegramUpdates.ts) and its daily cron
/// (jobs/index.ts) for the retention sweep that keeps this table small.
model ProcessedTelegramUpdate {
  id          Int      @id @default(autoincrement())
  updateId    BigInt   @unique(map: "ix_processed_telegram_update_update_id") @map("update_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_telegram_updates")
}

/// Client-side idempotency ledger for checkout/refund-style mutations — a
/// DIFFERENT mechanism from the Processed*Tx ledgers above (those dedupe an
/// inbound payment-gateway webhook callback; this dedupes a double-tapped or
/// retried request from a browser/admin client). The caller sends an
/// `Idempotency-Key` header; (key, endpoint) is claimed exactly once via the
/// unique index below. A retry with the same key AND the same requestHash
/// replays responseBody/statusCode verbatim instead of re-running the
/// mutation; the same key with a DIFFERENT hash means the key was reused for
/// a distinct request (a client bug) and is rejected with 409 rather than
/// silently replaying the wrong response or overwriting the original.
model IdempotencyRecord {
  id           Int      @id @default(autoincrement())
  key          String
  endpoint     String
  requestHash  String   @map("request_hash")
  responseBody String   @map("response_body")
  statusCode   Int      @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")
  /// Set while the request that claimed this key is still running (backend
  /// audit E2): the row is inserted as a reservation BEFORE the mutation runs,
  /// so a concurrent duplicate waits for it instead of running it a second
  /// time. Null once the response is saved — and null on every row written
  /// before this column existed, which were all completed responses. A claim
  /// older than IDEMPOTENCY_CLAIM_EXPIRY_MS (crud/idempotency.ts) is treated
  /// as crashed and can be taken over by a retry.
  pendingSince DateTime? @map("pending_since")

  @@unique([key, endpoint], map: "ix_idempotency_record_key_endpoint")
  @@map("idempotency_records")
}

/// grammY session storage — replaces the old in-memory `boundedSessionStorage`
/// (an LRU `Map`, lost on every restart) with a real StorageAdapter<SessionData>
/// backed by this table (`apps/order-bot/src/util/prismaSessionStorage.ts`).
/// `key` is grammY's session key — this bot uses the default `getSessionKey`,
/// one row per chat id. `data` is `ctx.session` JSON.stringify'd; every value
/// that reaches this column MUST already be a plain JSON-serializable object —
/// see prismaSessionStorage.ts's header comment for the Phase B landmine
/// (a `conversation.external()` result carrying a function/closure survived
/// only because the old storage was an in-memory `Map`; a real serialization
/// boundary like this table would silently corrupt it) this migration's
/// conversation.external() audit exists to guard against.
///
/// `kind` ("nav" | "checkout") implements the plan's TTL split — a session
/// mid-checkout (payment anchor set, a voucher applied, info-collection in
/// progress, ...) expires after the longest configured payment window across
/// every rail plus a 5-minute margin (35 minutes at default config, clamped
/// to never exceed it), instead of the 24h a "just browsing" session gets —
/// so an abandoned checkout's stale state (e.g. a payment-message anchor
/// pointing at a bubble the buyer walked away from) doesn't linger a full
/// day, while never expiring under a payment that's still legitimately
/// pending. See prismaSessionStorage.ts's
/// `classifySessionKind` for the exact rule. `expiresAt` is recomputed and
/// re-stamped on every write (a still-active session keeps sliding its own
/// expiry forward); the index below backs the daily prune sweep
/// (`cleanupExpiredBotSessionsJob`, jobs/index.ts) — grammY's own read/write
/// only ever queries by `key`.
model BotSession {
  key       String   @id
  data      String
  kind      String
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt], map: "ix_bot_session_expires_at")
  @@map("bot_sessions")
}

/// Detection Engine (packages/core/src/detection) vocabulary row: a single
/// normalized word/phrase classified into a TokenCategory (platform,
/// distribution, region, edition, denomination, noise) with a canonical
/// spelling and whether it's product-defining (splits the base product into
/// distinct product keys) or just descriptive. Seeded from
/// DEFAULT_KNOWLEDGE_BASE by scripts/seed-detection-knowledge.ts on first
/// run; admin-editable afterwards via the (future) detection-review UI.
model DetectionToken {
  id                Int     @id @default(autoincrement())
  category          String
  token             String
  canonical         String
  /// Whether this token splits the base product into a distinct product key
  /// (e.g. "pc" vs "mobile") rather than being purely descriptive.
  isProductDefining Boolean @map("is_product_defining")
  /// Soft-disable without deleting — a disabled token is still loaded into
  /// the KnowledgeBase (loadKnowledgeBase maps every row, enabled or not),
  /// but is excluded from feature extraction: the classifier in
  /// packages/core/src/detection/features.ts skips tokens where
  /// `enabled` is false. The row (and its edit history) is kept intact.
  enabled           Boolean @default(true)

  @@unique([category, token], map: "ix_detection_tokens_category_token")
  @@map("detection_tokens")
}

/// Maps a normalized alias phrase to the canonical normalized phrase it
/// should expand to before tokenization (e.g. a common misspelling or
/// supplier-specific shorthand) — see packages/core/src/detection/tokenize.ts.
model DetectionAlias {
  id        Int     @id @default(autoincrement())
  alias     String  @unique(map: "ix_detection_aliases_alias")
  expandsTo String  @map("expands_to")
  /// Free-text note on why this alias exists (e.g. "Digiflazz typo seen in
  /// prod"). Null = no note recorded.
  reason    String?

  @@map("detection_aliases")
}

/// Manual admin override for a single catalog input that the automatic
/// detector gets wrong (or can't resolve) — matched by either the
/// normalized product name or the supplier external id (`matchKind`) before
/// the automatic scoring path runs at all. `reason` is required (unlike
/// DetectionAlias.reason) so every override is self-documenting in the
/// review UI.
model DetectionOverride {
  id             Int      @id @default(autoincrement())
  matchKind      String   @map("match_kind")
  matchValue     String   @map("match_value")
  productKey     String   @map("product_key")
  baseProductKey String   @map("base_product_key")
  reason         String
  /// User.id of the admin who created this override. Null for a
  /// pre-attribution row or a CLI/break-glass write.
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  /// Incremented each time detect() actually applies this override — lets
  /// the review UI show which overrides are still load-bearing vs. dead.
  hitCount       Int      @default(0) @map("hit_count")

  @@unique([matchKind, matchValue], map: "ix_detection_overrides_match")
  @@map("detection_overrides")
}

/// A DetectionInput the engine could not confidently resolve ("ambiguous" or
/// "unknown" DetectionResult), queued for admin review. `inputFingerprint` is
/// a hash of the normalized input so the same recurring unresolved input
/// (e.g. every sync tick for the same supplier product) accumulates into one
/// row (`occurrences`/`lastSeenAt`) instead of spamming the review queue.
model DetectionIssue {
  id               Int      @id @default(autoincrement())
  /// DetectionResult.status for the most recent run that produced this issue
  /// ("ambiguous" | "unknown").
  status           String
  /// Admin review workflow state, independent of `status` above. One of
  /// "OPEN" | "RESOLVED" | "IGNORED" (enforced at the application layer, not
  /// the DB, matching this schema's existing free-text status-field
  /// convention — see Order.status / AdminTask.status).
  reviewStatus     String   @default("OPEN") @map("review_status")
  inputFingerprint String   @unique(map: "ix_detection_issues_fingerprint") @map("input_fingerprint")
  /// JSON-encoded DetectionInput that produced this issue, for the review UI
  /// to re-display without re-deriving it from the live catalog row.
  rawInput         String   @map("raw_input")
  reason           String
  /// JSON-encoded Candidate[] when status is "ambiguous"; null for "unknown".
  candidates       String?
  /// The detection-stamp (knowledge revision + catalog stamp) this issue was
  /// last produced under — a re-run under a newer stamp that still fails
  /// bumps `occurrences`/`lastSeenAt` rather than creating a duplicate row.
  detectorStamp    String   @map("detector_stamp")
  occurrences      Int      @default(1)
  firstSeenAt      DateTime @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime @updatedAt @map("last_seen_at")

  @@index([reviewStatus, lastSeenAt], map: "ix_detection_issues_status_seen")
  @@map("detection_issues")
}

// ---------------------------------------------------------------------------
// Financial Ledger (M1) — double-entry bookkeeping layer.
//
// Everything above this line records what the SHOP's domain did: an order was
// paid, a refund was approved, a wallet was credited. None of it answers "how
// much money does this business actually have, and where is it" — that answer
// was previously derived by summing domain tables, which cannot express money
// in transit (a gateway holding a settlement) or distinguish cash on hand from
// a customer-owed wallet balance.
//
// These six models are that missing layer: a FinancialTransaction is one
// real-world money event, its LedgerEntry children are the balanced
// debit/credit lines, and LedgerAccount is the chart of accounts they post
// against. The ledger is APPEND-ONLY — nothing edits or deletes a posted
// transaction; a mistake is cancelled by posting a REVERSAL that mirrors it
// (FinancialTransaction.reversalOfId). Every FK here is Restrict/NoAction for
// the same Infra-5 reason the rest of this schema's financial-audit rows are.
//
// ~~M1 SCOPE: NOTHING posts to this ledger yet.~~ Stale as of M2/M3: the
// posting service (packages/db/src/crud/ledger.ts) and its callers
// (packages/db/src/crud/ledgerPostings.ts, called from every real order,
// payment, wallet and refund code path) have existed since those milestones.
// A balance read off these tables is complete with respect to production
// traffic, not just what tests posted.
// ---------------------------------------------------------------------------

/// One row of the chart of accounts — the fixed set of buckets every
/// LedgerEntry posts against. Seeded, not user-created:
/// `scripts/seed-chart-of-accounts.ts` upserts the canonical 15 rows by
/// `code` and is safe to re-run (see `CHART_OF_ACCOUNTS`,
/// packages/db/src/crud/ledgerAccounts.ts).
///
/// `code` is the stable identifier every posting site refers to (a
/// `<purpose>.<currency>` string like "cash.idr"), deliberately NOT the
/// autoincrement `id` — the seed must be able to run against a fresh database
/// and an existing one and have posting code keep working either way, which an
/// id assigned by insertion order cannot guarantee. `name` is display-only and
/// safe to reword.
///
/// Accounts are never deleted (LedgerEntry.account is Restrict, and deleting an
/// account would orphan history anyway) — `isActive` retires one from the
/// pick-lists of future postings while leaving its past entries readable.
model LedgerAccount {
  id        Int      @id @default(autoincrement())
  /// Stable `<purpose>.<currency>` key, e.g. "cash.idr",
  /// "provider_clearing.usdt", "wallet_liability.idr". Unique, and the key the
  /// seed upserts on.
  code      String   @unique(map: "ix_ledger_accounts_code")
  name      String
  /// LedgerAccountType value (@app/core/enums) — ASSET | LIABILITY | REVENUE |
  /// EXPENSE | CLEARING | EQUITY. Free String, not a native Prisma enum,
  /// matching every other classification column in this schema.
  type      String
  /// "IDR" | "USDT" (OrderCurrency, @app/core/enums). An account is
  /// single-currency by design: this shop holds two unconvertible balances (see
  /// User.walletBalanceUsdt's "no cross-currency conversion" note), so a
  /// mixed-currency account could report a meaningless sum. Every LedgerEntry
  /// posted here must carry this same currency.
  currency  String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

/// One real-world money event, and the parent of the balanced set of
/// LedgerEntry rows that express it in double-entry form.
///
/// `idempotencyKey` is the load-bearing column: it is what makes posting safe
/// to retry. Every payment rail here is already at-least-once (webhooks
/// redeliver, pollers re-check the same order every cycle — see
/// markOrderUnderpaid's own comment in packages/db/src/crud/orderStatus.ts), so
/// a posting site WILL be asked to post the same event twice, and without a
/// unique key the ledger would silently double-count real money. It is unique
/// across the whole table (not scoped to a reference) so the caller has to
/// construct a key that names the specific event, not just the row it hangs off
/// it. The posting service enforces uniqueness and non-blankness only — it does
/// not enforce a shape. `ledgerPostings.ts` (the actual sole caller today) uses
/// `order:{orderId}:payment`, `order:{orderId}:topup`, `wallet:{walletTransactionId}`
/// and `refund_execution:{refundExecutionId}`, chosen so each is disjoint from
/// the others without needing a shared prefix.
///
/// `referenceType`/`referenceId` are an intentionally UNTYPED back-pointer
/// ("order" | "payment" | "refund_execution" | "wallet_topup" | "settlement" |
/// "manual"), not
/// a set of nullable FKs. A ledger is a general journal: it must be able to
/// record an event against anything, including a purely manual adjustment with
/// no domain row at all, and a column-per-domain shape would need a new
/// migration every time the ledger learns to record something new. The cost is
/// that the DB cannot enforce the pointer resolves; the index below is what
/// makes it usable in practice.
///
/// `occurredAt` vs `postedAt` are deliberately separate and must not be
/// collapsed: `occurredAt` is when the money actually moved in the real world
/// (a gateway's own timestamp, possibly days earlier for a backfilled
/// settlement), `postedAt` is when this row was written here. Financial
/// reporting for a period reads `occurredAt`; auditing what the books said at a
/// point in time reads `postedAt`. UTC in the DB as always (CLAUDE.md).
model FinancialTransaction {
  id             Int      @id @default(autoincrement())
  /// FinancialTransactionType value (@app/core/enums) — ORDER_PAYMENT |
  /// WALLET_DEPOSIT | WALLET_WITHDRAWAL | REFUND | REVERSAL | ADJUSTMENT | FEE
  /// | SETTLEMENT. Free String, not a native Prisma enum.
  type           String
  /// "order" | "payment" | "refund_execution" | "wallet_topup" | "settlement" |
  /// "manual". See
  /// this model's doc comment for why this pair is untyped.
  referenceType  String   @map("reference_type")
  referenceId    Int      @map("reference_id")
  /// Unique per posted event — the retry guard. See this model's doc comment.
  idempotencyKey String   @unique(map: "ix_financial_tx_idempotency_key") @map("idempotency_key")
  /// Human-readable summary of the event, for the admin-facing ledger view.
  /// Written as a natural-language sentence, not `key=value` shorthand — same
  /// audience and same convention as AuditLog.details (docs/LOGGING.md).
  description    String
  /// When the money moved in the real world (UTC). Supplied by the caller, NOT
  /// defaulted — a caller that means "now" must say so, so that a backfilled or
  /// settlement posting cannot silently claim to have occurred at import time.
  occurredAt     DateTime @map("occurred_at")
  /// When this row was written here (UTC). See the doc comment above for why
  /// this is not the same thing as `occurredAt`.
  postedAt       DateTime @default(now()) @map("posted_at")
  /// Set only on a REVERSAL: the FinancialTransaction this one cancels. The
  /// ledger is append-only, so this is the ONLY way a posted transaction is
  /// undone — see this model's doc comment.
  reversalOfId   Int?     @map("reversal_of_id")
  createdAt      DateTime @default(now()) @map("created_at")

  entries    LedgerEntry[]
  // Restrict, not Cascade (Infra-5 policy, as everywhere else in this schema's
  // financial-audit rows): deleting a transaction must never silently erase the
  // reversal that cancelled it, or vice versa.
  reversalOf FinancialTransaction?  @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversals  FinancialTransaction[] @relation("Reversal")

  @@index([referenceType, referenceId], map: "ix_financial_tx_reference")
  @@index([type, occurredAt], map: "ix_financial_tx_type_occurred")
  // Index the self-FK so "has this transaction already been reversed?" (the
  // `reversals` back-relation) is a lookup rather than a full scan, and so the
  // Restrict above does not have to scan the whole table on every delete.
  // Same index-every-FK-column convention the rest of this schema follows.
  @@index([reversalOfId], map: "ix_financial_tx_reversal_of")
  @@map("financial_transactions")
}

/// One debit or credit line of a FinancialTransaction — the actual
/// double-entry row.
///
/// INVARIANTS (enforced at the APPLICATION layer by the posting service, NOT
/// here — the same "app-layer invariant, not a CHECK constraint" pattern this
/// schema already documents on RefundItem's sum invariant):
///   1. `amount` is always POSITIVE. The sign is carried by `direction`, so
///      that a stored negative can never quietly flip a balance's meaning.
///   2. Per FinancialTransaction and per currency, the DEBIT amounts and the
///      CREDIT amounts sum to the same total. An unbalanced transaction is a
///      bug, not a state this schema can represent meaningfully.
///   3. `currency` equals the `currency` of the LedgerAccount in `accountId`.
///      Duplicated here rather than only joined from the account so a query can
///      group entries by currency without a join, matching this schema's
///      existing currency-snapshot convention (Payment.currency,
///      Refund.currency).
/// Postgres cannot express #2 (a cross-row aggregate) and this schema does not
/// use CHECK constraints for #1/#3 either; `postFinancialTransaction`
/// (packages/db/src/crud/ledger.ts) is the ledger's only writer and is where
/// these are checked before the first INSERT. They hold of every row this
/// service wrote (which is every row in this table — nothing else writes
/// here); they are not enforced at the database level.
model LedgerEntry {
  id                     Int      @id @default(autoincrement())
  financialTransactionId Int      @map("financial_transaction_id")
  accountId              Int      @map("account_id")
  /// LedgerDirection value (@app/core/enums) — DEBIT | CREDIT. Free String, not
  /// a native Prisma enum.
  direction              String
  /// Always positive; the sign is implied by `direction` (invariant #1 above).
  /// Decimal, never Float (CLAUDE.md money rule).
  amount                 Decimal
  /// Must match `account.currency` (invariant #3 above).
  currency               String
  createdAt              DateTime @default(now()) @map("created_at")

  // Restrict, not Cascade (Infra-5 policy): a ledger entry is the primary
  // financial-audit record in this schema — neither its parent transaction nor
  // its account may ever take it down with them.
  financialTransaction FinancialTransaction @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  account              LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([financialTransactionId], map: "ix_ledger_entries_ft")
  @@index([accountId], map: "ix_ledger_entries_account")
  @@map("ledger_entries")
}

/// One payout ATTEMPT against an approved Refund — the row that records money
/// actually going back to a buyer.
///
/// This exists because `Refund` alone cannot express it. Reaching
/// `Refund.status` COMPLETED is explicitly record-keeping only and triggers no
/// payout (see Refund.status's doc comment, and the `acknowledgeNoPayout` flag
/// `transitionRefundStatus` demands), which left "was this buyer actually paid
/// back, how, when, and by whom" unanswerable. That is this table.
///
/// One-to-many against Refund, not one-to-one: a FAILED execution does not
/// reopen or invalidate its parent Refund, so an admin can record a second
/// attempt as a new row while the first stays readable as history.
///
/// `executeRefund` (packages/db/src/crud/refunds.ts) is the ONLY thing that
/// writes this table at all: it pays the buyer (a wallet credit, or an
/// out-of-band transfer evidenced by `proofFileId`), records the payout here, and
/// posts the matching double-entry ledger event, all in one transaction. It
/// always inserts COMPLETED — see its own comment for why it never writes a
/// PENDING row first — so COMPLETED is the only status any row in this table
/// currently carries in production.
///
/// PENDING and FAILED are therefore both UNREACHABLE today, and the `status`
/// column's default of PENDING is never taken. This used to say a FAILED row "is
/// written by hand after the fact, when a transfer that really was attempted
/// bounced", which described a path that does not exist: there is no crud
/// function, no route and no admin screen that records a bounced payout, and
/// `executeRefund` deliberately writes nothing on failure (a mid-flight error
/// rolls the whole attempt away). The only thing that has ever written a FAILED
/// row is a test's own `prisma.refundExecution.create`.
///
/// The two values stay in the enum because the read side already handles them —
/// `reconcileLedger` and the refund reporting in crud/revenue.ts both filter on
/// `status: COMPLETED` precisely so a non-landed attempt cannot be counted as
/// money that moved — so whatever eventually records a bounced transfer will not
/// have to touch those consumers. Until something does, do not read a FAILED row
/// as evidence of a real failed payout: read it as something that wrote around
/// the application.
model RefundExecution {
  id          Int       @id @default(autoincrement())
  refundId    Int       @map("refund_id")
  /// RefundExecutionMethod value (@app/core/enums) — WALLET | MANUAL_TRANSFER.
  /// Free String, not a native Prisma enum.
  method      String
  /// Amount actually paid out in this attempt, in `currency`. Decimal, never
  /// Float (CLAUDE.md money rule). Not necessarily the whole `Refund.amount` —
  /// a refund may be settled in more than one attempt.
  amount      Decimal
  /// Snapshot of the currency this payout was made in — same
  /// snapshot-at-creation-time reasoning as Refund.currency's own doc comment.
  currency    String
  /// PENDING | COMPLETED | FAILED (RefundExecutionStatus, @app/core/enums).
  status      String    @default("PENDING")
  /// The payout's external identifier: a WalletTransaction id for a WALLET
  /// execution, or a bank/gateway transfer reference for a MANUAL_TRANSFER.
  /// Nullable — a PENDING attempt has none yet.
  reference   String?
  /// Evidence for a MANUAL_TRANSFER payout (a Telegram file_id or upload
  /// reference for the transfer receipt). NEVER log this value — payment-proof
  /// file_ids are on CLAUDE.md's "never log secrets" list.
  proofFileId String?   @map("proof_file_id")
  /// User.id of the admin who performed this payout. Required: a payout is a
  /// money-moving admin action and must always be attributable (CLAUDE.md's
  /// audit rule). No FK relation is declared, matching this schema's existing
  /// convention for admin-attribution columns (see DetectionOverride.createdBy).
  executedBy  Int       @map("executed_by")
  /// Set when this attempt reaches a terminal status (COMPLETED or FAILED) —
  /// mirrors Refund.processedAt's nullable-until-terminal pattern, and is NOT
  /// the same as `createdAt` below.
  executedAt  DateTime? @map("executed_at")
  /// Free-text admin explanation, same role as Refund.reason.
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  // Restrict, not Cascade (Infra-5 policy): a recorded payout is a
  // financial-audit record and must never be erasable by deleting its Refund.
  refund Refund @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([refundId], map: "ix_refund_executions_refund_id")
  @@map("refund_executions")
}

/// One payout batch a payment provider says it sent this shop — the bridge
/// between "the gateway confirmed the buyer paid" and "the money is in our bank
/// account". Those are different events, often days apart, and until this table
/// there was nowhere to record the second one, so a confirmed Payment was
/// implicitly treated as cash in hand.
///
/// `grossAmount`/`feeAmount`/`netAmount` are all stored as the provider
/// reported them rather than deriving `netAmount` — see Payment.netAmount's doc
/// comment for the same reasoning (recomputing invites silent rounding
/// disagreements with the provider's own arithmetic).
///
/// Manual admin entry is the only creation path in this milestone (hence the
/// required `createdBy`); no provider settlement API is wired up, and nothing
/// posts a SETTLEMENT FinancialTransaction from these rows yet.
model Settlement {
  id             Int      @id @default(autoincrement())
  /// PaymentMethod value (@app/core/enums) — TOKOPAY | PAYDISINI | NOWPAYMENTS
  /// | BINANCE | BYBIT. Free String, not a native Prisma enum, matching
  /// Payment.method and Order.paymentMethod.
  provider       String
  /// The provider's own identifier for this batch (a statement or payout id),
  /// as typed by the admin. Nullable — not every provider gives one, and an
  /// admin reconciling from a bank statement may have nothing to put here.
  /// Deliberately NOT unique: it is admin-typed free text from an external
  /// system, so a uniqueness violation here would block a legitimate entry over
  /// a provider's own id reuse rather than catch a real duplicate.
  batchReference String?  @map("batch_reference")
  /// The date the provider settled this batch (UTC; displayed via TIMEZONE like
  /// every other timestamp here). This, not `createdAt`, is what financial
  /// reporting for a period reads — the same `occurredAt` vs `postedAt`
  /// distinction FinancialTransaction draws.
  settlementDate DateTime @map("settlement_date")
  currency       String
  /// What the provider collected from buyers in this batch, before its cut.
  /// Decimal, never Float (CLAUDE.md money rule).
  grossAmount    Decimal  @map("gross_amount")
  /// The provider's total cut for this batch. Defaults to 0 (unlike
  /// Payment.fee, which is nullable): an admin entering a batch by hand has the
  /// statement in front of them, so "no fee line" genuinely means zero here
  /// rather than "unknown".
  feeAmount      Decimal  @default(0) @map("fee_amount")
  /// What actually landed in this shop's account. Stored, not derived — see
  /// this model's doc comment.
  netAmount      Decimal  @map("net_amount")
  /// RECORDED | RECONCILED | DISPUTED (SettlementStatus, @app/core/enums).
  status         String   @default("RECORDED")
  /// User.id of the admin who entered this batch. Required — manual entry is
  /// the only path, so there is always an accountable human (CLAUDE.md's audit
  /// rule). No FK relation declared, matching DetectionOverride.createdBy.
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  transactions SettlementTransaction[]

  @@index([provider, settlementDate], map: "ix_settlements_provider_date")
  @@map("settlements")
}

/// One line inside a Settlement batch, ideally matched to the Payment it
/// settles. This is where reconciliation actually happens: a batch's lines are
/// matched to `Payment` rows (on `Payment.providerTransactionId`, which is
/// exactly why that column was added), and a batch whose matched lines account
/// for its `netAmount` can move to RECONCILED.
///
/// `paymentId` is NULLABLE on purpose — an unmatched line is the single most
/// important thing this table has to be able to represent. A provider reporting
/// money this shop has no Payment row for is precisely the discrepancy
/// reconciliation exists to surface, and forcing a match would make that line
/// unrecordable (or, worse, invite matching it to the wrong payment just to
/// satisfy the constraint). `matchedAt` is null for exactly those lines.
model SettlementTransaction {
  id           Int       @id @default(autoincrement())
  settlementId Int       @map("settlement_id")
  /// The Payment this line settles, or null while unmatched. See this model's
  /// doc comment.
  paymentId    Int?      @map("payment_id")
  /// The amount the provider reported for this line, in `currency`. Decimal,
  /// never Float (CLAUDE.md money rule). Not assumed equal to the matched
  /// `Payment.amount` — a mismatch between the two is a finding to investigate,
  /// so both are kept.
  amount       Decimal
  currency     String
  /// When this line was matched to a Payment; null while unmatched.
  matchedAt    DateTime? @map("matched_at")

  // Restrict, not Cascade (Infra-5 policy): a settlement line is a
  // financial-audit record — neither its batch nor the Payment it matched may
  // silently erase it.
  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payment    Payment?   @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([settlementId], map: "ix_settlement_tx_settlement_id")
  // "Which settlement line(s) settled this Payment?" — the reconciliation read
  // in the other direction, and the index the Restrict on `payment` needs so
  // deleting a Payment does not scan every settlement line ever recorded.
  @@index([paymentId], map: "ix_settlement_tx_payment_id")
  @@map("settlement_transactions")
}

/// One buyer complaint that a DELIVERED credential is bad, and what was done
/// about it (Financial Ledger M18 — this table; M19 — the `replaceStockItem` /
/// `retryReplacementAllocation` / `refundInsteadOfReplace` services in
/// packages/db/src/crud/stockReplacement.ts, which are the ONLY writers; M20 —
/// the web-admin order/ticket UI that drives them).
///
/// Per-unit by construction, with no new granularity mechanism needed: this
/// schema already stores a bulk purchase as one `OrderItem` ROW PER UNIT rather
/// than a `quantity`-carrying shared row, so "unit #3 of 5 is dead" is already
/// addressable as a single `orderItemId`. That is the same fact `RefundItem`'s
/// own doc comment leans on ("buy 3 Netflix accounts, one turns out dead"), and
/// it is why this model points at an `OrderItem` rather than at an `Order` plus
/// a unit index.
///
/// `originalStockItemId` will always be a SOLD row, which is exactly why this
/// table exists as a separate record instead of being expressed by mutating the
/// stock row. `markStockDead`/`bulkMarkStockDead` (packages/db/src/crud/
/// stock.ts) deliberately REFUSE to touch a SOLD row — "a delivered credential
/// is never altered" — and that refusal is not to be loosened for this feature.
/// M19's service has its OWN narrow, audited path (`killDeliveredStockItem`) to
/// record a replacement; the delivered row's history stays intact and the swap
/// is described HERE, by a row that names both sides.
///
/// `replacementStockItemId`, `refundId` and `supportTicketId` are all nullable
/// because they describe three genuinely independent outcomes/origins rather
/// than one required chain:
///  - a request in REQUESTED/AWAITING_STOCK has no replacement yet, and one
///    that ends REFUNDED_INSTEAD never will (its `refundId` is set instead);
///  - `refundId` is only set on the refund-fallback branch
///    (`refundInsteadOfReplace`), which is the FIRST — and still the only —
///    production caller of `createRefund`/`createRefundItem`/`executeRefund`;
///  - `supportTicketId` links the ticket the complaint arrived on, but an admin
///    may also record a replacement from a Telegram DM or a phone call that
///    never became a ticket.
model StockReplacement {
  id                     Int       @id @default(autoincrement())
  /// The specific purchased UNIT being complained about — see this model's doc
  /// comment for why one OrderItem row IS one unit here.
  orderItemId            Int       @map("order_item_id")
  /// The bad credential that was actually delivered. A SOLD row, always, and it
  /// is never mutated or deleted to express this — that is this table's job.
  originalStockItemId    Int       @map("original_stock_item_id")
  /// The credential handed over as the replacement. Null until one is issued,
  /// and null forever for a request that ended REFUNDED_INSTEAD / CANCELLED /
  /// FAILED.
  replacementStockItemId Int?      @map("replacement_stock_item_id")
  /// Set only on the refund-fallback branch (status REFUNDED_INSTEAD), when no
  /// replacement stock could be issued and the buyer was given their money back
  /// instead. Null on every other path.
  refundId               Int?      @map("refund_id")
  /// The support ticket the complaint arrived on, when it arrived on one. Null
  /// for a replacement an admin recorded from any other channel.
  supportTicketId        Int?      @map("support_ticket_id")
  /// Free-text admin-typed explanation of what was wrong with the delivered
  /// credential ("password changed by owner", "account banned within 24h") —
  /// same precedent as `Refund.reason` and `Order.rejectionReason`, both
  /// deliberately free String rather than a constrained value set.
  reason                 String
  /// REQUESTED | AWAITING_STOCK | COMPLETED | REFUNDED_INSTEAD | CANCELLED |
  /// FAILED (StockReplacementStatus, @app/core/enums). String, not a native
  /// Prisma enum, matching every other lifecycle-status column in this schema
  /// (`Order.status`, `Refund.status`, `OrderItem.status`). The state machine
  /// that governs these transitions is `STOCK_REPLACEMENT_LEGAL_TRANSITIONS`
  /// (packages/db/src/crud/stockReplacement.ts).
  status                 String    @default("REQUESTED")
  /// User.id of the admin who opened this request. Required: replacing a
  /// delivered credential is a state change that must always be attributable
  /// (CLAUDE.md's audit rule). No FK relation is declared, matching this
  /// schema's existing convention for admin-attribution columns (see
  /// `RefundExecution.executedBy`, `Settlement.createdBy`,
  /// `DetectionOverride.createdBy`).
  requestedBy            Int       @map("requested_by")
  /// Set when this request reaches a terminal status (COMPLETED,
  /// REFUNDED_INSTEAD, CANCELLED, FAILED) — mirrors `Refund.processedAt` /
  /// `RefundExecution.executedAt`'s nullable-until-terminal pattern, and is NOT
  /// the same as `createdAt` below.
  resolvedAt             DateTime? @map("resolved_at")
  /// Free-text admin notes about the handling itself, distinct from `reason`
  /// (what was wrong) — same split as `Refund.reason` vs `RefundItem.reason`.
  notes                  String?
  createdAt              DateTime  @default(now()) @map("created_at")

  // Restrict/NoAction throughout (Infra-5 policy, security audit 2026-06-23):
  // a replacement record is an audit record of a delivered-goods correction, so
  // nothing it points at may be deleted out from under it — not the order line
  // it corrects, not either credential, not the refund that stood in for a
  // replacement, not the ticket it came in on. This matches RefundItem's and
  // SettlementTransaction's existing policy rather than the looser Cascade some
  // non-financial detail tables use.
  orderItem     OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  original      StockItem      @relation("ReplacementOriginal", fields: [originalStockItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  replacement   StockItem?     @relation("ReplacementNew", fields: [replacementStockItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refund        Refund?        @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supportTicket SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderItemId], map: "ix_stock_replacements_order_item")
  // The "has this delivered credential already been replaced once?" lookup
  // `replaceStockItem` runs before issuing another, and the same
  // index-every-FK-column convention
  // RefundItem follows for both of its FKs.
  @@index([originalStockItemId], map: "ix_stock_replacements_original_stock")
  // The admin queue's "what is still open" read (same reason `Refund` and
  // `Order` both carry a plain status index).
  @@index([status], map: "ix_stock_replacements_status")
  // The three nullable FKs get indexes for the same reason the two required ones
  // do: each is read from the other side ("was this stock row ever issued as a
  // replacement?", "which replacement did this refund stand in for?", "what
  // replacement came in on this ticket?"), and each carries an onDelete:
  // Restrict that Postgres otherwise enforces with a sequential scan of this
  // table on every delete of the referenced row.
  @@index([replacementStockItemId], map: "ix_stock_replacements_replacement_stock")
  @@index([refundId], map: "ix_stock_replacements_refund")
  @@index([supportTicketId], map: "ix_stock_replacements_support_ticket")
  @@map("stock_replacements")
}
