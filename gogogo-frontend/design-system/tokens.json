{
  "$meta": {
    "name": "gogogo-frontend design system tokens",
    "note": "Layout/component STRUCTURE was reverse-engineered from gogogo.id (2026-09-01). COLOR/TYPE/RADIUS/SHADOW values below are this repo's own 'Clean Modern' brand, copied 1:1 from apps/storefront/static/app.css and packages/web-ui/views/_theme.njk — the single source of truth. Update this file from there, not the other way round."
  },
  "color": {
    "palette": {
      "paper": "#f6f8fb",
      "card": "#ffffff",
      "sand": "#eef1f6",
      "line": "#e3e8ef",
      "ink": "#1b2330",
      "inkSoft": "#5a6473",
      "inkFaint": "#677288",
      "pine": "#2563eb",
      "pineDark": "#1d4ed8",
      "pineTint": "#e6effe",
      "grass": "#16a34a",
      "grassDark": "#15803d",
      "grassTint": "#e7f6ec",
      "amberx": "#b45c0a",
      "amberxTint": "#fdedcf",
      "rust": "#dc2626",
      "rustDark": "#b91c1c",
      "rustTint": "#fde7e7",
      "white": "#ffffff",
      "black": "#000000",
      "scrollbarThumb": "#c5cbd6"
    },
    "semantic": {
      "bg": "#f6f8fb",
      "surface": "#ffffff",
      "surfaceRaised": "#eef1f6",
      "field": "#ffffff",
      "border": "#e3e8ef",
      "text": "#1b2330",
      "textMuted": "#5a6473",
      "textDisabled": "#677288",
      "textOnPrimary": "#ffffff",
      "textOnAccent": "#ffffff",
      "action": "#2563eb",
      "actionHover": "#1d4ed8",
      "actionTint": "#e6effe",
      "success": "#16a34a",
      "successTint": "#e7f6ec",
      "priceHighlight": "#15803d",
      "discountBg": "#e7f6ec",
      "discountText": "#15803d",
      "warning": "#b45c0a",
      "warningTint": "#fdedcf",
      "error": "#dc2626",
      "errorTint": "#fde7e7",
      "overlay": "rgba(27,35,48,0.06)",
      "overlayStrong": "rgba(27,35,48,0.12)"
    }
  },
  "typography": {
    "fontFamily": {
      "display": "Outfit, system-ui, sans-serif",
      "sans": "Manrope, system-ui, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, monospace"
    },
    "fontSize": {
      "xs": "12px", "sm": "13px", "base": "14px", "md": "16px",
      "lg": "18px", "xl": "24px", "2xl": "30px"
    },
    "fontWeight": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "tight": 1.25, "normal": 1.5 },
    "letterSpacing": { "normal": "0", "tight": "-0.025em", "wide": "0.03em", "wider": "0.05em" },
    "roles": {
      "pageTitleMobile":  { "font": "display", "size": "24px", "weight": 600, "letterSpacing": "-0.025em" },
      "pageTitleDesktop": { "font": "display", "size": "30px", "weight": 600, "letterSpacing": "-0.025em" },
      "pageLead":         { "font": "sans", "size": "14px", "color": "inkSoft" },
      "sectionTitle":     { "font": "display", "size": "18px", "weight": 600 },
      "statValue":        { "font": "display", "size": "30px", "weight": 600, "lineHeight": 1 },
      "statLabel":        { "font": "sans", "size": "11.2px", "weight": 600, "transform": "uppercase", "letterSpacing": "0.05em", "color": "inkSoft" },
      "fieldLabel":       { "font": "sans", "size": "11.2px", "weight": 600, "transform": "uppercase", "letterSpacing": "0.05em", "color": "inkSoft" },
      "body":             { "font": "sans", "size": "16px", "weight": 400 },
      "buttonLabel":      { "font": "sans", "size": "14px", "weight": 600 },
      "tableHeader":      { "font": "sans", "size": "13px", "weight": 600, "transform": "uppercase", "letterSpacing": "0.03em", "color": "inkSoft" },
      "code":             { "font": "mono", "size": "12px" }
    }
  },
  "spacing": {
    "base": "4px",
    "scale": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
    "tapTarget": "44px"
  },
  "radius": { "xs": "4px", "sm": "8px", "md": "12px", "lg": "16px", "full": "9999px" },
  "elevation": {
    "shadowNone": "none",
    "shadowSoft": "0 1px 2px rgba(16,24,40,0.04), 0 8px 24px -14px rgba(16,24,40,0.12)",
    "shadowLift": "0 2px 4px rgba(16,24,40,0.06), 0 16px 36px -18px rgba(16,24,40,0.18)",
    "shadowFocus": "0 0 0 3px rgba(37,99,235,0.35)",
    "cardRecipe": "white .card on --paper, 1px --line border, shadow-soft; hover steps to shadow-lift"
  },
  "layout": {
    "containerMax": "1152px",
    "containerProse": "768px",
    "bottomNavHeight": "56px",
    "productGridColumns": { "mobile": 2, "tablet": 3, "desktop": 5 },
    "productDetailColumns": { "mobile": 1, "desktop": "summary + purchase (2-col)" }
  },
  "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px" },
  "motion": {
    "durationFast": "150ms",
    "durationEntrance": "500ms",
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "entranceKeyframes": "rise: opacity 0→1, translateY(8px)→0"
  }
}
