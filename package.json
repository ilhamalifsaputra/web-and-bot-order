{
  "name": "project-bot-order",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "build": "pnpm -r build",
    "build:bundle": "tsx scripts/build-bundle.ts",
    "reset-admin-password": "tsx scripts/reset-admin-password.ts",
    "inspect-digiflazz-catalog": "tsx scripts/inspect-digiflazz-catalog.ts",
    "split-digiflazz-regions": "tsx scripts/split-digiflazz-regions.ts",
    "split-digiflazz-types": "tsx scripts/split-digiflazz-types.ts",
    "backfill-encrypt-stock-credentials": "tsx scripts/backfill-encrypt-stock-credentials.ts",
    "backfill-encrypt-delivered-content": "tsx scripts/backfill-encrypt-delivered-content.ts",
    "reencrypt-credentials-v2": "tsx scripts/reencrypt-credentials-v2.ts",
    "backfill-stock-traceability": "tsx scripts/backfill-stock-traceability.ts",
    "backfill-player-input-configuration": "tsx scripts/backfill-player-input-configuration.ts",
    "audit-stock-integrity": "tsx scripts/audit-stock-integrity.ts",
    "backfill-encrypt-settings-secrets": "tsx scripts/backfill-encrypt-settings-secrets.ts",
    "backfill-ledger-history": "tsx scripts/backfill-ledger-history.ts",
    "images:backfill": "tsx scripts/backfill-webp.ts",
    "bybit-probe": "tsx scripts/bybit-internal-probe.ts",
    "binance-probe": "tsx scripts/binance-probe.ts",
    "diag-reconcile-drift": "tsx scripts/diag-reconcile-drift.ts",
    "parity-check-kind-filter": "tsx scripts/parity-check-kind-filter.ts",
    "check-migration-drift": "tsx scripts/check-migration-drift.ts",
    "check-migration-timestamps": "tsx scripts/check-migration-timestamps.ts",
    "check-frontend-boundaries": "tsx scripts/check-frontend-boundaries.ts",
    "check-detection-engine-purity": "tsx scripts/check-detection-engine-purity.ts",
    "seed-detection-knowledge": "tsx scripts/seed-detection-knowledge.ts",
    "seed-chart-of-accounts": "tsx scripts/seed-chart-of-accounts.ts",
    "export-detection-fixture": "tsx scripts/export-detection-fixture.ts",
    "start": "NODE_ENV=production tsx apps/server/src/index.ts",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.test.json",
    "pretest": "pnpm run check-migration-drift && pnpm run check-migration-timestamps && pnpm run check-frontend-boundaries && pnpm --filter @app/storefront-client lint && pnpm run check-detection-engine-purity",
    "test": "vitest run",
    "test:guards": "vitest run apps/order-bot/test/currency-onboarding.test.ts apps/order-bot/test/money-input-guard.test.ts apps/order-bot/test/keyboard-label-guard.test.ts tests/no-fake-claims.test.ts packages/core/src/moneyInput.test.ts packages/core/src/buttonLimits.test.ts packages/core/src/locales.test.ts packages/db/src/crud/dispatchTriggerGuard.test.ts apps/web-admin/client/src/components/ui/field-contrast.test.tsx",
    "test:changed": "vitest run --changed master --passWithNoTests && pnpm test:guards",
    "test:envelope-v2": "cross-env CREDENTIAL_ENVELOPE_WRITE_V2=1 vitest run packages/core packages/db scripts",
    "e2e": "playwright test",
    "dev:web": "pnpm --filter @app/web-admin dev",
    "dev:store": "pnpm --filter @app/storefront dev",
    "dev:bot": "pnpm --filter @app/order-bot dev"
  },
  "devDependencies": {
    "@app/core": "workspace:*",
    "@app/db": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "fast-check": "^4.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "pnpm": {
    "overrides": {
      "@fastify/busboy": "3.2.2",
      "find-my-way": "9.9.0",
      "proxy-addr": "2.0.8",
      "brace-expansion@>=1 <2": "1.1.21",
      "brace-expansion@>=2 <3": "2.1.7",
      "brace-expansion@>=5 <6": "5.0.12",
      "fast-uri": "3.1.8",
      "js-yaml@>=4 <5": "4.3.2",
      "postcss": "8.5.23",
      "nanoid@>=3 <4": "3.3.18",
      "browserslist": "4.28.7",
      "baseline-browser-mapping": "2.11.0",
      "source-map-js": "1.2.2"
    }
  }
}
