{% extends "base.njk" %}
{% import "_shop.njk" as shop %}

{% block title %}{{ t('web.checkout_title', lang) }} — {{ shop_name }}{% endblock %}

{% block content %}
{{ shop.stepper(2, lang) }}
<h1 class="page-title !text-2xl mb-5">{{ t('web.checkout_title', lang) }}</h1>

{% if error_key %}
<div class="card card-pad border-rust/40 bg-rust-tint text-rust-dark text-sm mb-5">
  <i data-lucide="alert-triangle" class="w-4 h-4"></i> {{ t(error_key, lang) }}
</div>
{% endif %}

<form method="post" action="/checkout" data-submit-once class="grid lg:grid-cols-3 gap-6 items-start">
  <input type="hidden" name="csrf_token" value="{{ customer.csrf }}">

  <div class="lg:col-span-2 space-y-6">
    {# Payment method = transaction currency (design.md §8b). Only methods that
       are turned ON (admin toggle) AND fully configured render — a disabled
       method is hidden entirely, not greyed out. The first one shown is the
       default selection (cascade in file/priority order). #}
    {% set any_method = idr_enabled or paydisini_enabled or binance_enabled or bybit_enabled or bybit_bsc_enabled or nowpayments_enabled %}
    <div class="card card-pad">
      <h2 class="section-title mb-3">{{ t('web.pay_method', lang) }}</h2>
      <div class="space-y-3">
        {% if idr_enabled %}
        <label class="flex items-start gap-3 p-3 rounded-xl border border-line hover:border-pine cursor-pointer">
          <input type="radio" name="method" value="qris" class="mt-1" checked>
          <img src="/static/pay/qris.png" alt="QRIS" class="h-7 w-auto max-w-[80px] object-contain shrink-0 mt-0.5">
          <span>
            <span class="font-semibold text-sm block">{{ t('web.pay_idr_title', lang) }}</span>
            <span class="text-xs text-ink-soft block mt-0.5">{{ t('web.pay_idr_sub', lang) }}</span>
          </span>
        </label>
        {% endif %}
        {% if paydisini_enabled %}
        <label class="flex items-start gap-3 p-3 rounded-xl border border-line hover:border-pine cursor-pointer">
          <input type="radio" name="method" value="paydisini" class="mt-1" {% if not idr_enabled %}checked{% endif %}>
          <img src="/static/pay/qris.png" alt="PayDisini" class="h-7 w-auto max-w-[80px] object-contain shrink-0 mt-0.5">
          <span>
            <span class="font-semibold text-sm block">{{ t('web.pay_paydisini_title', lang) }}</span>
            <span class="text-xs text-ink-soft block mt-0.5">{{ t('web.pay_paydisini_sub', lang) }}</span>
          </span>
        </label>
        {% endif %}
        {% if binance_enabled %}
        <label class="flex items-start gap-3 p-3 rounded-xl border border-line hover:border-pine cursor-pointer">
          <input type="radio" name="method" value="binance" class="mt-1" {% if not idr_enabled and not paydisini_enabled %}checked{% endif %}>
          <img src="/static/pay/binance.png" alt="Binance" class="h-7 w-7 object-contain shrink-0 mt-0.5">
          <span>
            <span class="font-semibold text-sm block">{{ t('web.pay_usdt_title', lang) }}</span>
            <span class="text-xs text-ink-soft block mt-0.5">{{ t('web.pay_usdt_sub', lang) }}</span>
          </span>
        </label>
        {% endif %}
        {% if bybit_enabled %}
        <label class="flex items-start gap-3 p-3 rounded-xl border border-line hover:border-pine cursor-pointer">
          <input type="radio" name="method" value="bybit" class="mt-1" {% if not idr_enabled and not paydisini_enabled and not binance_enabled %}checked{% endif %}>
          <img src="/static/pay/bybit.png" alt="Bybit" class="h-7 w-7 rounded object-contain shrink-0 mt-0.5">
          <span>
            <span class="font-semibold text-sm block">{{ t('web.pay_bybit_title', lang) }}</span>
            <span class="text-xs text-ink-soft block mt-0.5">{{ t('web.pay_bybit_sub', lang) }}</span>
          </span>
        </label>
        {% endif %}
        {% if bybit_bsc_enabled %}
        <label class="flex items-start gap-3 p-3 rounded-xl border border-line hover:border-pine cursor-pointer">
          <input type="radio" name="method" value="bybit_bsc" class="mt-1" {% if not idr_enabled and not paydisini_enabled and not binance_enabled and not bybit_enabled %}checked{% endif %}>
          <img src="/static/pay/bybit.png" alt="Bybit" class="h-7 w-7 rounded object-contain shrink-0 mt-0.5">
          <span>
            <span class="font-semibold text-sm block">{{ t('web.pay_bybit_bsc_title', lang) }}</span>
            <span class="text-xs text-ink-soft block mt-0.5">{{ t('web.pay_bybit_bsc_sub', lang) }}</span>
          </span>
        </label>
        {% endif %}
        {% if nowpayments_enabled %}
        <label class="flex items-start gap-3 p-3 rounded-xl border border-line hover:border-pine cursor-pointer">
          <input type="radio" name="method" value="nowpayments" class="mt-1" {% if not idr_enabled and not paydisini_enabled and not binance_enabled and not bybit_enabled and not bybit_bsc_enabled %}checked{% endif %}>
          <img src="/static/pay/nowpayments.png" alt="NOWPayments" class="h-7 w-7 rounded object-contain shrink-0 mt-0.5">
          <span>
            <span class="font-semibold text-sm block">{{ t('web.pay_nowpayments_title', lang) }}</span>
            <span class="text-xs text-ink-soft block mt-0.5">{{ t('web.pay_nowpayments_sub', lang) }}</span>
          </span>
        </label>
        {% endif %}
        {% if not any_method %}
        <div class="text-center text-sm text-ink-soft border border-dashed border-line rounded-xl py-6 px-3">
          <i data-lucide="wallet" class="w-5 h-5 mx-auto mb-1.5 text-ink-faint"></i>
          <p>{{ t('web.pay_none_available', lang) }}</p>
        </div>
        {% endif %}
      </div>
    </div>

    {# Voucher — Apply is a plain button (never type="submit"): it previews
       the discount via HTMX against /checkout/voucher/preview instead of
       submitting the real checkout form (Task 8 fix — this used to be
       indistinguishable from clicking Place Order for a valid code).
       hx-include="closest form" carries voucher_code + csrf_token (and any
       other form fields) along; the swap only replaces #checkout-summary,
       so this input's live value is untouched and still submits with the
       real "Place Order" click afterwards. #}
    <div class="card card-pad">
      <label class="field-label" for="voucher_code">{{ t('web.voucher_label', lang) }}</label>
      <div class="flex gap-2">
        <input id="voucher_code" name="voucher_code" value="{{ voucher_code }}" class="field uppercase"
               placeholder="{{ t('web.voucher_placeholder', lang) }}" maxlength="32">
        <button type="button" hx-post="/checkout/voucher/preview" hx-include="closest form"
                hx-target="#checkout-summary" hx-swap="innerHTML"
                class="btn btn-soft shrink-0">{{ t('web.voucher_apply', lang) }}</button>
      </div>
    </div>

    {# Wallet credits (only shown when user has a positive balance) #}
    {% if wallet_idr and wallet_idr != "0" %}
    <div class="card card-pad">
      <h2 class="section-title mb-2">{{ t('web.wallet_label', lang) }}</h2>
      <label class="flex items-center gap-3 cursor-pointer">
        <input type="checkbox" name="use_wallet_idr" value="1" class="w-4 h-4 accent-pine">
        <span class="text-sm">{{ t('web.wallet_use_idr', lang, { amount: wallet_idr | idr }) }}</span>
      </label>
      <p class="text-xs text-ink-soft mt-1.5">{{ t('web.wallet_idr_note', lang) }}</p>
    </div>
    {% endif %}
    {% if wallet_usdt and wallet_usdt != "0" %}
    <div class="card card-pad">
      {% if not (wallet_idr and wallet_idr != "0") %}
      <h2 class="section-title mb-2">{{ t('web.wallet_label', lang) }}</h2>
      {% endif %}
      <label class="flex items-center gap-3 cursor-pointer">
        <input type="checkbox" name="use_wallet_usdt" value="1" class="w-4 h-4 accent-pine">
        <span class="text-sm">{{ t('web.wallet_use_usdt', lang, { amount: (wallet_usdt | money) + ' USDT' }) }}</span>
      </label>
      <p class="text-xs text-ink-soft mt-1.5">{{ t('web.wallet_usdt_note', lang) }}</p>
    </div>
    {% endif %}
  </div>

  {# Totals — extracted into _checkout_totals.njk (Task 8 fix) so the
     voucher-preview HTMX response can re-render just this card. #}
  <div id="checkout-summary">
    {% include "_checkout_totals.njk" %}
  </div>
</form>
{% endblock %}
