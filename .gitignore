# --- dependencies ---
node_modules/

# --- secrets / local env (NEVER commit) ---
.env
.env.*
!.env.example

# --- local MCP server config (token via ${HOSTINGER_API_TOKEN} env var) ---
.mcp.json

# --- runtime data: DB (+ WAL/SHM/backups), logs (any nesting) ---
data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.bak-*
*.log
.tmp/
tmp/

# --- Python (legacy stack) ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- build output ---
dist/
build/
*.tsbuildinfo
coverage/
apps/web-admin/static/dashboard-app/
apps/storefront/static/shop-app/

# --- Prisma generated client (regenerated via prisma generate) ---
**/generated/

# --- local working dirs (audit reports / execution scratch) ---
/execution/
/audit/

# --- git worktrees (isolated workspaces for parallel feature work) ---
/.worktrees/

# --- Playwright MCP scratch output (console logs, page snapshots) ---
/.playwright-mcp/

# --- subagent-driven-development scratch (task briefs, reports, progress ledger) ---
/.superpowers/

# --- graphify auto-update hook scratch (lock dir + run log, see .claude/settings.json) ---
graphify-out/.update.lock
graphify-out/.update.log

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
