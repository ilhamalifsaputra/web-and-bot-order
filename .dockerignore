# Keep the build context small and reproducible.

# Reinstalled fresh in the builder from the lockfile.
node_modules
**/node_modules

# Runtime data is a mounted volume — never bake the dev DB / logs into the image.
data/
**/*.db
**/*.db-wal
**/*.db-shm
.tmp/

# VCS / tooling / local secrets.
.git
.gitignore
**/*.log
.env
.env.*
!.env.example

# AI coding-assistant tooling (not read by build or runtime).
.agents/
.augment/
.claude/
.codebuddy/
.codewhale/
.continue/
.cursor/
.factory/
.gemini/
.kilocode/
.kiro/
.opencode/
.qoder/
.roo/
.superpowers/
.trae/
.warp/
.windsurf/
.audit-data/

# Editor / OS noise.
.vscode
.idea
**/.DS_Store
