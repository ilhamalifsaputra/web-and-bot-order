// Single Prisma schema shared by all services (order-bot, web-admin, notifier).
// Originally introspected from the production database, then remapped to clean
// PascalCase models / camelCase fields. Every @map / @@map preserves the exact
// table & column names so the data layout stays identical to the original
// SQLAlchemy schema. Enums stay String for compatibility.
// DO NOT change column names/types — that would break the shared DB.

generator client {
  provider = "prisma-client-js"
  // No binaryTargets: the deploy runs `prisma generate` (postinstall) ON the
  // target Linux host, so "native" already produces the correct Linux query
  // engine there. Hardcoding Linux targets here would force every dev/CI machine
  // to download extra engine binaries on each generate.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_PRISMA")
}

model User {
  id                Int       @id @default(autoincrement())
  telegramId        BigInt?   @unique(map: "ix_users_telegram_id") @map("telegram_id")
  username          String?
  fullName          String?   @map("full_name")
  /// Web-store login handle (3-32 chars [a-z0-9_], stored lowercase).
  /// Distinct from `username` (= Telegram username, bot-owned).
  loginUsername     String?   @unique(map: "ix_users_login_username") @map("login_username")
  email             String?   @unique(map: "ix_users_email")
  passwordHash      String?   @map("password_hash")
  role              String    @default("CUSTOMER")
  language          String    @default("EN")
  walletBalance     Decimal   @default(0) @map("wallet_balance")
  /// USDT credit balance (IDR balance is `walletBalance`). Spent only on USDT
  /// orders — no cross-currency conversion (dual-credit-balance design §A).
  walletBalanceUsdt Decimal   @default(0) @map("wallet_balance_usdt")
  referralCode      String    @unique(map: "ix_users_referral_code") @map("referral_code")
  referredById      Int?      @map("referred_by_id")
  banned            Boolean   @default(false)
  bannedReason      String?   @map("banned_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastSeenAt        DateTime? @map("last_seen_at")
  /// True for guest-checkout user rows: no telegramId / loginUsername /
  /// passwordHash. Used as a security gate at /api/v1/track — only orders
  /// belonging to a guest user may be opened with code+email. Upgrading the
  /// row to a full account clears this: `setLoginCredentials` sets it false
  /// (and nulls `guestEmail`) as soon as the row is given a `passwordHash`,
  /// so the code+email shortcut can never bypass a password.
  isGuest           Boolean   @default(false) @map("is_guest")
  /// Contact email a guest shopper enters at checkout. NOT unique (unlike
  /// the registered account's `email`) — one guest row per checkout
  /// session, and the same email may be used repeatedly. Nulled together
  /// with `isGuest` when the row gains a password (see above).
  guestEmail        String?   @map("guest_email")
  /// Display-only currency preference: "USD" | "IDR" (`DisplayCurrency` in
  /// @app/core/enums). NULL = not chosen yet — no default, no backfill. Never
  /// affects the payment currency, which is still chosen at pay time.
  preferredCurrency String?   @map("preferred_currency")

  referredBy User?  @relation("UserReferral", fields: [referredById], references: [id], onUpdate: NoAction)
  referees   User[] @relation("UserReferral")

  orders                Order[]
  cartItems             CartItem[]
  reviews               Review[]
  restockSubscriptions  RestockSubscription[]
  auditLogs             AuditLog[]
  auditLogsAsCustomer   AuditLog[]            @relation("AuditLogCustomer")
  ticketMessages        TicketMessage[]
  walletTransactions    WalletTransaction[]
  passwordResetTokens   PasswordResetToken[]
  referralsAsReferee    Referral?             @relation("ReferralReferee")
  referralsAsReferrer   Referral[]            @relation("ReferralReferrer")
  ticketsAsUser         SupportTicket[]       @relation("TicketUser")
  ticketsAsAdmin        SupportTicket[]       @relation("TicketAdmin")
  ticketsAssignedBy     SupportTicket[]       @relation("TicketAssignedBy")
  voucherRedemptions    VoucherRedemption[]
  reviewsRepliedAsAdmin Review[]              @relation("ReviewRepliedByAdmin")
  adminTasksAssigned    AdminTask[]           @relation("AdminTaskAssignee")
  stockItemsAddedAsAdmin      StockItem[]      @relation("StockItemAddedByAdmin")
  stockItemsDeletedAsAdmin    StockItem[]      @relation("StockItemDeletedByAdmin")
  stockItemEventsAsActorAdmin StockItemEvent[] @relation("StockItemEventActorAdmin")
  stockItemEventsAsCustomer   StockItemEvent[] @relation("StockItemEventActorCustomer")

  @@index([role, createdAt], map: "ix_users_role_created_at")
  @@index([lastSeenAt], map: "ix_users_last_seen_at")
  @@map("users")
}

/// Append-only per-user money timeline. One row per applied wallet movement,
/// written by `adjustWallet` so NOTHING that touches a balance is missed:
/// manual admin top-ups, underpaid refunds, referral payouts, order
/// payments/refunds. `balanceAfter` is the running balance at the time.
model WalletTransaction {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  delta        Decimal // signed: +credit / −debit (the amount actually applied)
  balanceAfter Decimal  @map("balance_after")
  /// Currency of this ledger row's balance/delta. Existing rows default to IDR
  /// (the system was IDR-base); USDT rows track the USDT credit balance.
  currency     String   @default("IDR")
  // machine code: admin_adjust | underpaid_refund | referral | order_payment |
  // order_refund | adjust | wallet_topup | unfulfilled_credit | overpaid_credit.
  // `overpaid_credit` (task F2) is the excess a buyer overpaid, handed back as
  // wallet balance by creditOverpaymentToBalance — deliberately its OWN code
  // rather than admin_adjust, because admin_adjust rows carry a null orderId and
  // so escape the (orderId, reason) UNIQUE below that stops a second credit.
  reason       String
  note         String?
  adminId      Int?     @map("admin_id") // acting admin (null = system/customer)
  orderId      Int?     @map("order_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Restrict, not Cascade (Infra-5 fix, security audit 2026-06-23): this is an
  // append-only financial ledger — deleting a User must never silently erase
  // their wallet history. No code path hard-deletes a User today (ban is the
  // moderation tool); this is a schema-level guardrail against ever adding one.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// "One wallet movement per order per reason" (Task E5 item 2). Every
  /// order-scoped reason is already once-per-order in the code, but each by a
  /// DIFFERENT mechanism — an atomic claim (`wallet_topup`, via
  /// settleWalletTopup), a read-then-throw (`unfulfilled_credit`, via
  /// creditOrderToBalance), a status transition inside the same transaction
  /// (`underpaid_refund`, via refundUnderpaidOrder), a terminal-status guard
  /// on all three callers (`order_refund`, via releaseOrderHolds), a UNIQUE on
  /// another table (`referral`, via Referral.refereeId) and simply having one
  /// creation path per order (`order_payment`). This constraint is the one
  /// place that statement is true structurally rather than six times over by
  /// argument, so weakening any of those six can no longer silently double a
  /// buyer's money.
  ///
  /// Rows with a NULL orderId are unconstrained — NULLs are distinct in a
  /// Postgres UNIQUE index — which is what the two `admin_adjust` sites and the
  /// `adjust` default need: an admin may top a customer up any number of
  /// times, and those movements belong to no order.
  ///
  /// Deliberately NOT `[orderId, reason, currency]`. Today an order settles in
  /// exactly one currency, so adding it would constrain nothing. But the
  /// six-mechanism argument above is currency-BLIND: if a future caller ever
  /// lets one order spend both IDR and USDT credit — which
  /// `applyUsdtWalletToOrder` (crud/orders.ts) explicitly anticipates in its
  /// own doc comment — the second `order_payment` row would throw P2002 in
  /// production, on a legitimate payment, with no test catching it first.
  /// Widen this constraint in the same change that adds such a caller.
  @@unique([orderId, reason], map: "ix_wallet_transactions_order_id_reason")
  @@index([userId], map: "ix_wallet_transactions_user_id")
  @@map("wallet_transactions")
}

/// Forgot-password tokens for the storefront. Only the SHA-256 hex of the
/// token is stored; rows are single-use (used_at) and expire after 1 hour.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique(map: "ix_password_reset_tokens_hash") @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "ix_password_reset_tokens_user_id")
  @@map("password_reset_tokens")
}

model Category {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  /// URL-safe handle (storefront `/c/:slug`). Backfilled from name at the
  /// catalog-rename migration; UNIQUE + NOT NULL.
  slug         String  @unique(map: "ix_categories_slug")
  emoji        String?
  description  String?
  /// Web-facing category image URL (admin-set, storefront only).
  image        String?
  sortOrder    Int     @default(0) @map("sort_order")
  isActive     Boolean @default(true) @map("is_active")
  /// Top-level bucket for the bot's "🛍 Products" entry point — GAME_TOPUP |
  /// PREMIUM_APPS (packages/core/src/enums.ts CategoryGroup). Admin-set, null
  /// until classified. A category with no group is unreachable from the
  /// customer group→category picker until an admin assigns one — it stays
  /// reachable via search, Popular, and /start deep links, which are
  /// intentionally group-agnostic.
  group        String?
  /// How checkout behaves for every product/denomination under this category:
  /// "catalog" (default, unchanged behavior — normal cart/checkout flow) or
  /// "instant" (Digiflazz-backed top-up pilot — buyer enters a game ID/server
  /// at checkout and the order auto-dispatches to the supplier on payment).
  checkoutFlow String  @default("catalog") @map("checkout_flow")

  products Product[]

  @@map("categories")
}

/// Mid-tier of the catalog (Category → **Product** → Denomination). The
/// customer-facing item (e.g. "CapCut Pro"); carries image/description/nav only.
/// NO price, NO stock — those live on each child Denomination (the sellable SKU).
/// Physically the old `product_groups` table, renamed to `products`.
model Product {
  id                      Int      @id @default(autoincrement())
  categoryId              Int      @map("category_id")
  name                    String
  /// URL-safe handle (storefront `/p/:slug`). UNIQUE + NOT NULL.
  slug                    String   @unique(map: "ix_products_slug")
  emoji                   String?
  description             String?
  /// Storefront-only detail blocks, rendered under `description` on the
  /// product page and folded into its structured data. All optional — a
  /// product created before these existed simply shows fewer blocks.
  /// What the buyer actually receives ("Akun private, 1 device…").
  whatYouGet              String?  @map("what_you_get")
  /// Product-specific rules ("jangan ganti email — garansi hangus").
  terms                   String?
  /// Warranty detail for this product, overriding the generic warranty copy.
  warrantyNote            String?  @map("warranty_note")
  /// Web-facing product photo URL (admin-set, storefront only). Telegram
  /// imageFileId can't be used as an <img src>. When null the storefront
  /// renders a generated DefaultThumb placeholder (a lucide icon in a tinted
  /// well), keyed by `thumbnailKind` / category `group` / a category-name
  /// heuristic — see `thumbnailKind` below and `defaultThumbKind` in
  /// apps/storefront/src/images.ts.
  webImageUrl             String?  @map("web_image_url")
  imageFileId             String?  @map("image_file_id")
  /// Default placeholder art style shown when no `webImageUrl` is set —
  /// admin-set, null = auto-resolve from category. One of "game" | "voucher"
  /// | "steam" | "entertainment" | "app" | "generic".
  thumbnailKind           String?  @map("thumbnail_kind")
  /// Currency-icon style shown on this product's DenominationCard chips —
  /// admin-set, null = auto-resolve (or always null for PREMIUM_APPS
  /// category). One of "diamond" | "coin" | "key" | "card" | "voucher".
  currencyIconKind        String?  @map("currency_icon_kind")
  /// The exact Digiflazz `brand` string this Product was imported from (Import
  /// Wizard). Null for hand-created products. Re-sync matching key — chosen
  /// over matching by name so the admin can rename the display name freely
  /// without breaking future syncs.
  digiflazzBrand          String?  @map("digiflazz_brand")
  /// Game Top Up display grouping only (Category.group === "GAME_TOPUP");
  /// Premium Apps products leave this null and render exactly as today.
  /// Free-text edition label distinguishing multiple purchasable editions of
  /// one game, e.g. "Infinite" vs "Umum" for Arena Breakout. Null = no
  /// variant distinction; the bot nav skips the variant-picker screen for
  /// this category.
  /// Auto-seeded by the Digiflazz import (groupDigiflazzPriceListByBrand)
  /// when one brand reports >= 2 distinct Digiflazz `type` values, and by the
  /// split-digiflazz-types migration for products imported before that
  /// existed. Import writes it on Product CREATE only and never overwrites an
  /// existing value, so an admin edit always wins. Otherwise admin-set.
  /// The value mirrors Digiflazz's own `type` term ("Umum" for the base
  /// edition); it is unrelated to the Digiflazz Product-name "(Region)"
  /// suffix, which is a separate supplier re-sync mechanism.
  gameVariant             String?  @map("game_variant")
  /// Admin-set emoji shown on the variant-picker button (prefixed to
  /// gameVariant's label) and reused as a prefix on denomination buttons
  /// under this product. Kept separate from gameVariant so the bot never
  /// has to parse an emoji back out of admin-authored text.
  gameVariantEmoji        String?  @map("game_variant_emoji")
  /// Admin-set free-text region/country label (e.g. "🇮🇩 Indonesia") — any
  /// flag glyph is part of this string, unlike gameVariantEmoji, since a
  /// region label is only ever rendered once, at the region picker.
  /// Independent of the Digiflazz Product-name "(Region)" suffix, which does
  /// not backfill this field.
  gameRegion              String?  @map("game_region")
  sortOrder               Int      @default(0) @map("sort_order")
  isActive                Boolean  @default(true) @map("is_active")
  /// Soft-hide independent of isActive: an archived product drops out of the
  /// admin's default catalog list and every customer-facing surface, but
  /// keeps its data (denominations, order history) intact — unlike a hard
  /// Delete, which is refused once it has denominations.
  isArchived              Boolean  @default(false) @map("is_archived")
  createdAt               DateTime @default(now()) @map("created_at")
  /// Detection Engine (packages/core/src/detection) output, cached on the
  /// Product row so read paths never call detect() inline. Null = never run
  /// / not yet classified. All five fields are written together by the
  /// detection sync job (a later task) — never partially.
  detectionBaseProductKey String?  @map("detection_base_product_key")
  /// The full product key (base key + defining-token suffix) this Product
  /// was resolved to — see packages/core/src/detection/keys.ts.
  detectionProductKey     String?  @map("detection_product_key")
  /// detect()'s DetectionResult.status ("resolved" | "ambiguous" | "unknown")
  /// for this Product's most recent classification run.
  detectionStatus         String?  @map("detection_status")
  /// detect()'s confidence score [0,1] for the most recent classification.
  detectionConfidence     Decimal? @map("detection_confidence")
  /// Opaque cache-invalidation stamp (knowledge revision + catalog stamp) the
  /// classification was produced with — a mismatch against the current live
  /// stamp means this row's detection fields are stale and due a re-run.
  detectionStamp          String?  @map("detection_stamp")

  category        Category         @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  denominations   Denomination[]
  voucherProducts VoucherProduct[]
  supportTickets  SupportTicket[]

  @@index([categoryId], map: "ix_products_category_id")
  @@index([detectionProductKey], map: "ix_products_detection_product_key")
  @@map("products")
}

/// Leaf of the catalog — the sellable SKU (e.g. "1 Month"). Price, cost, stock
/// and auto-delivery all live here. Physically the old `products` table, renamed
/// to `denominations`; ids are preserved so every dependent `product_id` FK
/// (stock_items, order_items, cart_items, bulk_pricing, reviews,
/// restock_subscriptions) keeps pointing at the same rows.
model Denomination {
  id                    Int       @id @default(autoincrement())
  productId             Int       @map("product_id")
  name                  String
  /// URL-safe handle. UNIQUE + NOT NULL.
  slug                  String    @unique(map: "ix_denominations_slug")
  description           String?
  imageFileId           String?   @map("image_file_id")
  /// Web-facing photo URL (admin-set, storefront only); null → curated fallback.
  webImageUrl           String?   @map("web_image_url")
  type                  String
  durationLabel         String    @map("duration_label")
  price                 Decimal
  /// Unit cost for margin reporting. Null = unknown / not tracked.
  costPrice             Decimal?  @map("cost_price")
  resellerPrice         Decimal?  @map("reseller_price")
  /// Source key for auto-fulfilment (e.g. provider/handler id). Null = manual.
  autoDeliverySource    String?   @map("auto_delivery_source")
  /// The Digiflazz `buyer_sku_code` this denomination maps to (e.g. "ML86").
  /// Null for every non-Digiflazz SKU — set only when autoDeliverySource
  /// points at the Digiflazz supplier.
  supplierSku           String?   @map("supplier_sku")
  /// Exact supplier product name from the latest import/resync, before any
  /// display cleaning. Null for legacy rows until a real supplier sync.
  supplierRawName       String?   @map("supplier_raw_name")
  /// Manual override for the auto-detected nickname-check game (KokinPay's
  /// game_code, e.g. "mobile-legends") — normally the engine auto-detects the
  /// game from Product.digiflazzBrand against the static catalog
  /// (packages/core/src/nickname/gameCatalog.ts); set this only when that
  /// auto-detection is wrong or absent for this SKU. Null = pure auto-detect,
  /// still the common case — the field still works as plain text either way,
  /// never blocks the buyer. Admin copies this value from KokinPay's own
  /// game-code list (api.kokinpay.com/docs/kode-game).
  /// Independent of autoDeliverySource/supplierSku — this is a storefront UX
  /// enhancement, not a fulfilment link, so it applies to any manual_with_info
  /// product regardless of who (if anyone) auto-fulfils it.
  nicknameCheckGameCode String?   @map("nickname_check_game_code")
  /// True once an admin has manually edited this SKU's price after import.
  /// The Digiflazz re-sync job (packages/db/src/crud/digiflazz.ts,
  /// resyncDigiflazzCatalog) skips price recomputation for any row where this
  /// is true, so a deliberate manual price change is never silently
  /// overwritten by the next sync tick.
  priceOverridden       Boolean   @default(false) @map("price_overridden")
  /// Game Top Up compact-label display only. The pure numeric top-up amount
  /// (e.g. 2500), decoupled from name/durationLabel's free text — which for
  /// Digiflazz-imported rows already repeats the game name (e.g. "Mobile
  /// Legends 86 Diamonds") and can't be reliably re-parsed. Null = this SKU
  /// has no compact quantity set; the bot falls back unchanged to
  /// durationLabel||name.
  qtyValue              Int?      @map("qty_value")
  /// The short unit word paired with qtyValue on the compact button, e.g.
  /// "Diamonds", "UC", "Bonds". Set together with qtyValue by the admin,
  /// never derived/parsed from name/durationLabel.
  qtyUnit               String?   @map("qty_unit")
  warrantyDays          Int       @default(30) @map("warranty_days")
  sortOrder             Int       @default(0) @map("sort_order")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  /// When true, adding stock to this SKU enqueues a "back in stock" DM to
  /// every non-banned customer with a linked Telegram account (not just
  /// RestockSubscription opt-ins) via notification_outbox.
  broadcastOnRestock    Boolean   @default(false) @map("broadcast_on_restock")
  /// How this SKU is fulfilled: "auto" (pull stock, deliver instantly — default,
  /// unchanged behavior), "manual" (admin types & sends the account by hand, no
  /// stock), or "manual_with_info" (manual + buyer fills custom fields at
  /// checkout before payment). See packages/core/src/enums.ts DeliveryType.
  deliveryType          String    @default("auto") @map("delivery_type")
  /// For "manual_with_info" only: JSON-encoded array of buyer-input field specs
  /// (key/label{id,en}/type/required/options/placeholder). Null otherwise. Stored
  /// as TEXT per the repo's JSON-in-string convention (see NotificationOutbox).
  additionalFields      String?   @map("additional_fields")
  /// Flash sale: percent off (0,100] that REPLACES the base price for everyone
  /// while now is inside [flashStartsAt, flashEndsAt). All three fields are set
  /// and cleared together — any of them null means this SKU has no flash sale.
  /// Bulk pricing and vouchers still stack on top of the discounted price; a
  /// reseller pays whichever of resellerPrice/flash price is cheaper, never
  /// both discounts (see effectiveUnitPrice in @app/core/flash).
  flashDiscountPercent  Decimal?  @map("flash_discount_percent")
  flashStartsAt         DateTime? @map("flash_starts_at")
  flashEndsAt           DateTime? @map("flash_ends_at")
  /// Stamped once the "flash sale started" broadcast has been enqueued, so the
  /// announce job can't fan it out twice. Reset to null whenever the schedule
  /// is rewritten or cleared, which is what lets the same SKU be flashed again.
  flashAnnouncedAt      DateTime? @map("flash_announced_at")
  /// Detection Engine (packages/core/src/detection) SKU-level key this
  /// Denomination was resolved to (denomination category, e.g. which
  /// diamond-pack tier). Null = never classified. Companion to
  /// Product.detectionProductKey, not a duplicate of it.
  detectionSkuKey       String?   @map("detection_sku_key")
  /// Same cache-invalidation stamp convention as Product.detectionStamp.
  detectionStamp        String?   @map("detection_stamp")

  product              Product                  @relation(fields: [productId], references: [id], onUpdate: NoAction)
  stockItems           StockItem[]
  orderItems           OrderItem[]
  cartItems            CartItem[]
  reviews              Review[]
  restockSubscriptions RestockSubscription[]
  bulkPricing          BulkPricing?
  providerMappings     ProductProviderMapping[]

  @@index([productId], map: "ix_denominations_product_id")
  // The announce job scans for flash sales that have started but not yet been
  // broadcast; both it and the catalog reads filter on the window's end.
  @@index([flashEndsAt], map: "ix_denominations_flash_ends_at")
  @@index([detectionSkuKey], map: "ix_denominations_detection_sku_key")
  @@map("denominations")
}

/// Maps a Denomination (SKU) to a transaction-fulfilment provider's own SKU
/// code, supporting multi-provider dispatch routing. Digiflazz is the only
/// real transaction provider today; this
/// model exists to remove the STRUCTURAL blocker — a SKU hard-bound to
/// Digiflazz in the schema via Denomination.autoDeliverySource/supplierSku
/// alone — so a second provider can be added later without a schema
/// migration. No second adapter or fallback-on-failure routing is built here
/// (see .superpowers/sdd/task-4-brief.md); the per-order Digiflazz dispatch
/// path (packages/db/src/crud/digiflazz.ts) keeps reading
/// Denomination.autoDeliverySource/supplierSku directly and unchanged — this
/// model's resolver (packages/db/src/crud/productProviderMappings.ts) is what
/// keeps those two cache fields in sync with the current top-priority enabled
/// mapping, so the read-heavy dispatch path stays a single-table read.
///
/// `productId` is named to match every other FK to Denomination already in
/// this schema (OrderItem.productId, CartItem.productId, StockItem.productId)
/// — Denomination was physically the old `products` table (see its own doc
/// comment above), so `product_id` is this repo's established column name
/// for "the SKU this row is about", not a reference to the mid-tier Product
/// model.
model ProductProviderMapping {
  id           Int       @id @default(autoincrement())
  /// Holds a Denomination id — see this model's doc comment for why the
  /// column is named product_id.
  productId    Int       @map("product_id")
  /// Provider identifier: "digiflazz" today; free-text so a second
  /// transaction provider can be added later without a schema change.
  provider     String
  /// The provider's own SKU/product code for this Denomination (Digiflazz's
  /// buyer_sku_code, e.g. "ML86").
  providerSku  String    @map("provider_sku")
  /// The provider's last-known cost for this SKU, for margin reporting —
  /// populated by a future price-sync job (explicitly deferred, see
  /// task-4-brief.md's "provider price/balance sync workers (D4)"); null
  /// until then. Decimal, never float (CLAUDE.md money rule).
  providerCost Decimal?  @map("provider_cost")
  /// When providerCost was last refreshed from the provider. Null until a
  /// future sync job sets it.
  costSyncedAt DateTime? @map("cost_synced_at")
  /// false temporarily disables this provider for this SKU (soft-disable
  /// without deleting) — the resolver skips a disabled row when recomputing
  /// the Denomination's cached autoDeliverySource/supplierSku.
  enabled      Boolean   @default(true)
  /// Ascending priority order; 0 = highest priority, tried first by the
  /// resolver when more than one enabled provider row exists for this SKU.
  priority     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  product Denomination @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, provider], map: "ix_product_provider_mappings_product_provider")
  @@index([productId, enabled, priority], map: "ix_product_provider_mappings_product_priority")
  @@map("product_provider_mappings")
}

model StockItem {
  id          Int       @id @default(autoincrement())
  /// Holds a denomination id (column kept as `product_id` to avoid a rename).
  productId   Int       @map("product_id")
  credentials String
  status      String    @default("AVAILABLE")
  orderId     Int?      @map("order_id")
  addedAt     DateTime  @default(now()) @map("added_at")
  reservedAt  DateTime? @map("reserved_at")
  soldAt      DateTime? @map("sold_at")
  note        String?

  // ── Stock traceability hardening plan, Fase 1 (schema-only, additive) ──
  // These columns are all nullable or safely defaulted; no crud code reads
  // or writes them yet. They exist so a later phase can record identity/
  // provenance/lifecycle detail without a further migration.
  //
  // identityFingerprint/credentialFingerprint MUST be a keyed HMAC (server
  // pepper held outside the DB, alongside CREDENTIAL_ENCRYPTION_KEY) when a
  // later phase populates them — never an unkeyed hash. A plain SHA-256 of
  // the plaintext credential stored next to that same credential's own
  // ciphertext would let anyone with DB read access confirm a guessed
  // credential offline, undoing the point of Fase 6's encryption hardening.
  identityFingerprint   String?   @map("identity_fingerprint")
  credentialFingerprint String?   @map("credential_fingerprint")

  soldToOrderId     Int? @map("sold_to_order_id")
  soldToOrderItemId Int? @map("sold_to_order_item_id")

  addedByAdminId Int?     @map("added_by_admin_id")
  importBatchId  Int?     @map("import_batch_id")
  supplierRef    String?  @map("supplier_ref")
  unitCost       Decimal? @map("unit_cost")

  // Query-only mirror of the keyVersion already stored authoritatively
  // inside the credentials envelope (credentialCrypto.ts's encryptCredentials
  // writes keyVersion into the JSON blob; decryptCredentials reads it back
  // from there). Left nullable with NO default here deliberately:
  // docs/archive/audit-stock-traceability-fase0.md
  // notes the count of legacy-plaintext / non-v1 rows has not been measured
  // against production, so stamping every existing row "1" would assert an
  // unverified fact. A later phase's backfill populates this from the
  // envelope's own value; the envelope stays the source of truth either way.
  credentialKeyVersion Int? @map("credential_key_version")

  warrantyUntil       DateTime? @map("warranty_until")
  replacesStockItemId Int?      @map("replaces_stock_item_id")

  lastCheckedAt   DateTime? @map("last_checked_at")
  lastCheckResult String?   @map("last_check_result")

  deletedAt        DateTime? @map("deleted_at")
  deletedByAdminId Int?      @map("deleted_by_admin_id")

  deadReason String? @map("dead_reason")

  // Dedup claim (Fase 5a): "{productId}:{credentialFingerprint}" while the row
  // is live (AVAILABLE/RESERVED/SOLD), NULL once DEAD or soft-deleted so the
  // credential can be re-imported. A full nullable unique (many NULLs allowed)
  // because deploy is `db push`, which never applies a partial index.
  activeCredentialKey String? @unique(map: "ux_stock_items_active_credential_key") @map("active_credential_key")

  // Relation field kept as `product` for source-compat; it resolves to a
  // Denomination (the SKU). Renamed to `denomination` in Phase 5 cleanup.
  product                Denomination       @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order                  Order?             @relation(fields: [orderId], references: [id], onUpdate: NoAction)
  orderItems             OrderItem[]
  // Two roles, so two back-references (naming follows this schema's existing
  // `<plural>As<Role>` convention for multi-role relations: User's
  // `referralsAsReferee`/`referralsAsReferrer`, `ticketsAsUser`/
  // `ticketsAsAdmin`). "AsOriginal" = this row was the bad credential someone
  // complained about; "AsNew" = this row was handed over to replace one.
  replacementsAsOriginal StockReplacement[] @relation("ReplacementOriginal")
  replacementsAsNew      StockReplacement[] @relation("ReplacementNew")

  // Warranty-replacement chain (Fase 7): the spare row points at the row it replaced.
  replacesStockItem StockItem?  @relation("StockItemReplacement", fields: [replacesStockItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replacedBy        StockItem[] @relation("StockItemReplacement")

  events      StockItemEvent[]
  importBatch StockImportBatch? @relation(fields: [importBatchId], references: [id], onUpdate: NoAction)
  addedByAdmin   User? @relation("StockItemAddedByAdmin", fields: [addedByAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deletedByAdmin User? @relation("StockItemDeletedByAdmin", fields: [deletedByAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "ix_stock_items_status")
  @@index([productId], map: "ix_stock_items_product_id")
  @@index([productId, status], map: "ix_stock_product_status")
  @@index([identityFingerprint], map: "ix_stock_items_identity_fingerprint")
  @@index([credentialFingerprint], map: "ix_stock_items_credential_fingerprint")
  @@index([soldToOrderId], map: "ix_stock_items_sold_to_order_id")
  @@index([importBatchId], map: "ix_stock_items_import_batch_id")
  @@index([replacesStockItemId], map: "ix_stock_items_replaces_stock_item_id")
  @@map("stock_items")
}

// Immutable lifecycle-event log for a StockItem (stock traceability
// hardening plan, Fase 1). Recorded alongside — never instead of — the
// mutable columns on StockItem itself, so a rollback/substitution keeps its
// history instead of losing it to a null-out/overwrite. Every stock
// lifecycle path writes its event here (import, reserve/release, sale,
// substitution, dead/soft-delete, reveal, re-encrypt, backfill).
//
// onDelete: Restrict on stockItem is deliberate — a lifecycle event must
// never disappear along with the row it describes. It holds because no app
// path hard-deletes a StockItem: bulkDeleteStock/deleteStockItem
// (packages/db/src/crud/stock.ts) only soft-delete (set deletedAt), and
// Denomination's `onDelete: Cascade` to StockItem (the `product` relation
// above) is never reached for a denomination that ever held stock —
// deleteDenomination and the product delete refuse it first
// (assertNoStockHistory in packages/db/src/crud/catalog.ts; the denomination
// can only be deactivated). Only the test-reset helper deletes stock rows,
// and it deletes their events first.
model StockItemEvent {
  id          Int     @id @default(autoincrement())
  stockItemId Int     @map("stock_item_id")
  eventType   String  @map("event_type")
  fromStatus  String? @map("from_status")
  toStatus    String? @map("to_status")

  orderId     Int? @map("order_id")
  orderItemId Int? @map("order_item_id")

  actorType       String  @map("actor_type")
  actorAdminId    Int?    @map("actor_admin_id")
  actorCustomerId Int?    @map("actor_customer_id")

  reasonCode    String?  @map("reason_code")
  // Intended (not yet enforced — additive phase) dedup key for a future
  // unique index once idempotent event-writing matters:
  // (stockItemId, eventType, correlationId).
  correlationId String?  @map("correlation_id")
  // JSONB (Prisma `Json`), not the `String?` this schema otherwise uses for
  // free-form data (see OrderStatusHistory.meta, NotificationOutbox.payloadJson)
  // — deliberate deviation: this is the one column meant to hold queryable
  // structured detail per event rather than a fixed human-readable string.
  // Caution for whichever phase first writes to it: a nullable Json field
  // distinguishes SQL NULL from a JSON `null` value (Prisma's DbNull vs.
  // JsonNull) and rejects a bare `null` literal on write.
  meta          Json?
  occurredAt    DateTime @default(now()) @map("occurred_at")

  stockItem     StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorAdmin    User?     @relation("StockItemEventActorAdmin", fields: [actorAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorCustomer User?     @relation("StockItemEventActorCustomer", fields: [actorCustomerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([stockItemId, occurredAt], map: "ix_stock_item_events_stock_item_id_occurred_at")
  @@index([orderId], map: "ix_stock_item_events_order_id")
  @@index([eventType, occurredAt], map: "ix_stock_item_events_event_type_occurred_at")
  @@map("stock_item_events")
}

// One row per bulk stock-import operation (stock traceability hardening
// plan, Fase 1). StockItem.importBatchId will point back here so a later
// phase can trace a credential to the exact import run that added it. Fase
// 1 only adds this table; no crud code writes to it yet.
model StockImportBatch {
  id            Int      @id @default(autoincrement())
  adminId       Int?     @map("admin_id")
  productId     Int?     @map("product_id")
  sourceLabel   String?  @map("source_label")
  sourceHash    String?  @map("source_hash")
  rowsSubmitted Int      @map("rows_submitted")
  rowsInserted  Int      @map("rows_inserted")
  rowsDuplicate Int      @map("rows_duplicate")
  createdAt     DateTime @default(now()) @map("created_at")

  items StockItem[]

  @@index([createdAt], map: "ix_stock_import_batches_created_at")
  @@map("stock_import_batches")
}

model Order {
  id                     Int       @id @default(autoincrement())
  orderCode              String    @unique(map: "ix_orders_order_code") @map("order_code")
  userId                 Int       @map("user_id")
  subtotalAmount         Decimal   @map("subtotal_amount")
  discountAmount         Decimal   @default(0) @map("discount_amount")
  uniqueCents            Decimal   @default(0) @map("unique_cents")
  totalAmount            Decimal   @map("total_amount")
  voucherId              Int?      @map("voucher_id")
  walletUsed             Decimal   @default(0) @map("wallet_used")
  bulkDiscountAmount     Decimal   @default(0) @map("bulk_discount_amount")
  status                 String    @default("PENDING_PAYMENT")
  /// Transaction currency, set when the buyer picks a payment method
  /// (plan.md §15): "IDR" (TokoPay) or "USDT" (Binance). Catalog prices are
  /// central IDR; rows created before this column existed are USDT-era
  /// snapshots (see scripts/convert-prices-to-idr.ts).
  currency               String    @default("IDR")
  /// Rupiah-per-USDT snapshot taken when currency=USDT, so later rate edits
  /// never change what historical orders were charged.
  fxRate                 Decimal?  @map("fx_rate")
  paymentMethod          String    @default("BINANCE_PAY") @map("payment_method")
  paymentRef             String?   @unique(map: "ix_orders_payment_ref") @map("payment_ref")
  paymentMsgChatId       BigInt?   @map("payment_msg_chat_id")
  paymentMsgId           Int?      @map("payment_msg_id")
  paymentProofFileId     String?   @map("payment_proof_file_id")
  binanceTxid            String?   @map("binance_txid")
  bybitTxid              String?   @map("bybit_txid")
  adminNote              String?   @map("admin_note")
  rejectionReason        String?   @map("rejection_reason")
  createdAt              DateTime  @default(now()) @map("created_at")
  expiresAt              DateTime? @map("expires_at")
  paidAt                 DateTime? @map("paid_at")
  deliveredAt            DateTime? @map("delivered_at")
  /// For manual_with_info orders: JSON-encoded list of the buyer's per-unit
  /// answers (keyed by field `key`), collected at checkout before payment. Null
  /// for auto/manual orders. TEXT per the JSON-in-string convention.
  customerData           String?   @map("customer_data")
  /// For manual / manual_with_info orders: the exact text the admin sent when
  /// fulfilling the order by hand (audit trail). Null for auto orders.
  deliveredContent       String?   @map("delivered_content")
  /// On-chain network of the tracked deposit (e.g. "BSC"). Set only by the
  /// Bybit BSC confirmation tracker — null forever for every other payment
  /// method, which have no block-depth concept to report.
  network                String?   @map("network")
  /// Live confirmation count from a read-only block-explorer lookup. Null
  /// means "no real count available" (the renderer's signal to never show a
  /// fabricated number) — only the Bybit BSC rail ever sets this.
  confirmations          Int?      @map("confirmations")
  requiredConfirmations  Int?      @map("required_confirmations")
  /// When the deposit was first seen on-chain, before Bybit itself reports it
  /// confirmed — distinct from `paidAt` (set only once Bybit's own status
  /// reaches Success).
  firstDetectedAt        DateTime? @map("first_detected_at")
  /// PRODUCT (default) | WALLET_TOPUP. A WALLET_TOPUP order has no OrderItem
  /// rows, no voucher, no stock — settlement credits the buyer's wallet via
  /// settleWalletTopup instead of settlePaidOrder/approveOrder.
  kind                   String    @default("PRODUCT") @map("kind")
  /// When the tracker's own confirmation count first reached
  /// `requiredConfirmations` — a display-grade milestone, intentionally
  /// separate from `paidAt`/`deliveredAt` (which stay gated on Bybit's report).
  confirmedAt            DateTime? @map("confirmed_at")
  /// Set once the confirmation tracker's on-chain lookup has failed
  /// MAX_CONSECUTIVE_LOOKUP_FAILURES consecutive times (tx genuinely vanished
  /// from the explorer, or a flaky free-tier API key) — a *non-terminal*
  /// "tracking is uncertain" flag, not a status transition (M-11 fix, backend
  /// audit 2026-07-31): the order stays in PAYMENT_DETECTED/CONFIRMING (still
  /// inside PRE_DELIVERY_STATUSES) so a later genuine Bybit "Success" report
  /// can still auto-deliver it. Cleared back to null the next time an
  /// explorer lookup succeeds.
  trackingStaleAt        DateTime? @map("tracking_stale_at")
  /// Idempotency guard for the Digiflazz dispatch poller (later task): set
  /// atomically via an `updateMany`-with-status-guard claim (mirrors
  /// `fulfillManualOrder`'s pattern, packages/db/src/crud/orders.ts:1657-1661)
  /// the moment this order is dispatched to Digiflazz, so a poller crash/retry
  /// can never place the same top-up order twice. Null = not yet dispatched.
  digiflazzDispatchedAt  DateTime? @map("digiflazz_dispatched_at")
  /// Digiflazz supplier-dispatch sub-status — separate from Order.status
  /// (which stays PROCESSING for every one of these until DELIVERED) because
  /// Order.status already carries broader lifecycle meaning (PROCESSING/
  /// DELIVERED/CANCELLED/...) consumed by many other status-driven code paths
  /// — conflating "how the supplier call is going" into it risks breaking
  /// those. Null = not yet dispatched (mirrors digiflazzDispatchedAt: null).
  /// One of: "pending_at_supplier" (dispatched, awaiting Sukses/Gagal —
  /// covers both a fresh dispatch and a later backoff recheck), "failed"
  /// (terminal — either an explicit Gagal, or the recheck backoff window was
  /// exhausted still Pending/erroring; requires manual admin fulfilment,
  /// same remedy as today). No "delivered" value here — that's
  /// Order.status=DELIVERED.
  digiflazzStatus        String?   @map("digiflazz_status")
  /// Recheck/retry attempt counter for the backoff schedule (0 at first
  /// dispatch, incremented on each recheck attempt whether it's a re-poll of
  /// a Pending order or a retry of a transient HTTP/network failure).
  digiflazzAttempts      Int       @default(0) @map("digiflazz_attempts")
  /// When this order is next due for a recheck — drives
  /// dispatchPendingDigiflazzOrders's claim query for the "already dispatched,
  /// due for a recheck" branch. Null once terminal (delivered or failed) or
  /// before the first dispatch.
  digiflazzNextRecheckAt DateTime? @map("digiflazz_next_recheck_at")
  /// Internal-only diagnostic for admins (AuditLog/admin UI) — the raw
  /// Digiflazz message or exception text from the last failed attempt. NEVER
  /// shown to the buyer — the buyer-facing copy is fixed, reassuring i18n
  /// text, not this field.
  digiflazzFailureDetail String?   @map("digiflazz_failure_detail")
  /// Internal-only diagnostic for admins (OrderDetailPage/AuditLog) — set automatically
  /// when a Digiflazz fulfillment failure gave no specific reason of its own; holds the
  /// result of a fallback KokinPay nickname lookup on the order's target account, to
  /// help distinguish "wrong ID/region" from other causes. NEVER shown to the buyer.
  accountDiagnosticNote String? @map("account_diagnostic_note")
  /// Client-minted UUID (Task A1), stamped once when the bot's "Confirm & Pay"
  /// bubble is first rendered for a given checkout attempt and passed through
  /// to createOrderDirect/createOrderFromCart. The unique constraint is the
  /// atomic, DB-enforced guard against two near-simultaneous "Buy Now" taps
  /// both creating an order — see packages/db/src/crud/orders.ts's
  /// DuplicateCheckoutIntentError. Nullable: existing rows and any
  /// non-bot-originated order creation path never set it.
  checkoutIntentId       String?   @unique(map: "ix_orders_checkout_intent_id") @map("checkout_intent_id")

  user               User                 @relation(fields: [userId], references: [id], onUpdate: NoAction)
  voucher            Voucher?             @relation(fields: [voucherId], references: [id], onUpdate: NoAction)
  items              OrderItem[]
  stockItems         StockItem[]
  reviews            Review[]
  tickets            SupportTicket[]
  referrals          Referral[]
  notificationOutbox NotificationOutbox[]
  voucherRedemptions VoucherRedemption[]
  statusHistory      OrderStatusHistory[]
  refunds            Refund[]
  adminTasks         AdminTask[]
  payments           Payment[]

  @@index([userId], map: "ix_orders_user_id")
  @@index([status], map: "ix_orders_status")
  @@index([binanceTxid], map: "ix_orders_binance_txid")
  @@index([bybitTxid], map: "ix_orders_bybit_txid")
  @@index([status, createdAt], map: "ix_orders_status_created")
  @@index([status, deliveredAt], map: "ix_orders_status_delivered")
  @@index([kind], map: "ix_orders_kind")
  @@index([digiflazzStatus, digiflazzNextRecheckAt], map: "ix_orders_digiflazz_recheck")
  @@map("orders")
}

/// Append-only audit trail of every Order.status transition. A dedicated
/// table (not a JSON column on Order) specifically because a JSON array can't
/// usefully index inside a JSON array, and [orderId, occurredAt] needs a
/// real index for the live-tracking timeline render.
model OrderStatusHistory {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  status     String
  occurredAt DateTime @default(now()) @map("occurred_at")
  meta       String?

  // Restrict, not Cascade — mirrors Review/Referral's existing policy for
  // audit-significant Order children (Infra-5 fix, security audit
  // 2026-06-23): no code path hard-deletes an Order today; this is a
  // schema-level guardrail against ever adding one that would silently
  // erase status history.
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId, occurredAt], map: "ix_order_status_history_order_occurred")
  @@map("order_status_history")
}

model OrderItem {
  id                   Int     @id @default(autoincrement())
  orderId              Int     @map("order_id")
  /// Holds a denomination id (column kept as `product_id` to avoid a rename).
  productId            Int     @map("product_id")
  stockItemId          Int?    @map("stock_item_id")
  quantity             Int     @default(1)
  unitPrice            Decimal @map("unit_price")
  warrantyDaysSnapshot Int     @map("warranty_days_snapshot")
  /// Denomination.deliveryType frozen at order-creation time. settlePaidOrder
  /// reads THIS, not the live denomination row, so editing a SKU's
  /// deliveryType after an order was placed can never flip which branch
  /// (auto-deliver vs. hand-fulfil) an in-flight order takes — otherwise an
  /// AUTO order's reserved StockItem rows get stranded RESERVED forever if
  /// the SKU is edited to manual before payment, or a MANUAL order gets
  /// misrouted into the auto-deliver branch and fails out-of-stock if edited
  /// to auto before payment (M-5, backend audit 2026-07-31).
  ///
  /// Nullable, no default: this repo's real deploy path is `prisma db push`
  /// (see docs/MIGRATIONS.md / CLAUDE.md), not `prisma migrate deploy`, so the
  /// migration's backfill UPDATE never actually runs in practice — a NOT NULL
  /// default would silently mis-snapshot every pre-existing row as "auto" at
  /// the deploy boundary, reintroducing the exact manual->auto stranding bug
  /// this field exists to prevent. Null means "row predates this snapshot";
  /// settlePaidOrder falls back to the live denomination row for those, i.e.
  /// exactly the pre-Task-15 behavior — zero regression risk either way.
  deliveryTypeSnapshot String? @map("delivery_type_snapshot")
  /// Per-line fulfilment state — OrderItemStatus (@app/core/enums): PENDING,
  /// WAITING_FOR_INFO, INFO_SUBMITTED, QUEUED, PROCESSING, DELIVERED, FAILED,
  /// CANCELLED. String, not a native enum, matching every other enum column in
  /// this schema.
  ///
  /// A SHADOW of Order.status, not a source of truth. Nothing branches on it:
  /// settlePaidOrder still takes one whole-order auto-vs-manual branch and
  /// writes every item's status to match that branch's outcome, in the same
  /// transaction as the order-level status write. Since the cart composition
  /// rule (@app/core/cartComposition) keeps every order homogeneous, the items
  /// of an order always share one status. Added by Trustance Phase 1 Task 3 as
  /// the foundation a later plan needs to let lines resolve independently.
  ///
  /// Nullable, no default — the SAME deploy-boundary reasoning as
  /// deliveryTypeSnapshot directly above, and for once that is not a copied
  /// caveat but the load-bearing choice: `prisma db push` adds the column
  /// without running any backfill, so `NOT NULL DEFAULT 'PENDING'` would stamp
  /// PENDING onto the items of every order ever delivered. Null means "row
  /// predates this column"; deriveOrderStatusFromItems reads it as "unknown"
  /// and declines to derive anything, which is exactly the pre-Task-3
  /// behavior for those rows.
  status               String? @map("status")

  // Restrict, not Cascade (Infra-5 fix, security audit 2026-06-23): line items
  // are the order's financial detail — deleting an Order must never silently
  // erase them. No code path hard-deletes an Order today; this is a
  // schema-level guardrail against ever adding one.
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // `product` resolves to a Denomination (SKU); renamed in Phase 5 cleanup.
  product           Denomination       @relation(fields: [productId], references: [id], onUpdate: NoAction)
  stockItem         StockItem?         @relation(fields: [stockItemId], references: [id], onUpdate: NoAction)
  refundItems       RefundItem[]
  adminTasks        AdminTask[]
  /// Replacement requests raised against this purchased unit (Financial Ledger
  /// M18). An array, not a single row: a replacement credential can itself turn
  /// out bad, so the same unit may be replaced more than once.
  stockReplacements StockReplacement[]

  @@index([orderId], map: "ix_order_items_order_id")
  @@index([productId], map: "ix_order_items_product_id")
  @@map("order_items")
}

model Refund {
  id                Int       @id @default(autoincrement())
  orderId           Int       @map("order_id")
  /// Total refund amount for this Refund row, in `currency` below. For a
  /// partial/per-item refund this should equal the sum of its RefundItem
  /// rows' amounts. Enforced by `createRefundItem` (packages/db/src/crud/
  /// refunds.ts): any RefundItem insert that would push the running
  /// per-refund sum over this Refund.amount is rejected. See RefundItem's
  /// doc comment for the (separate, already-enforced) cross-refund
  /// per-OrderItem budget invariant, which is unrelated to this one.
  amount            Decimal
  /// Snapshot of the currency the ORIGINAL payment was made in (IDR or
  /// USDT), copied at Refund-creation time from `Order.currency` — not
  /// derived by joining back to Order on read. Mirrors this schema's
  /// existing convention for order-adjacent financial snapshots: e.g.
  /// `Order.fxRate` freezes the IDR/USDT rate "so later rate edits never
  /// change what historical orders were charged", and `OrderItem.unitPrice`
  /// freezes the price paid independent of later catalog price edits. A
  /// refund must stay pinned to its original payment's currency for the
  /// same reason — if a future admin edits how currency conversion works,
  /// every already-decided refund amount must stay exactly what was
  /// approved.
  currency          String
  /// Free-text admin-typed explanation ("dead account, buyer confirmed",
  /// "goodwill refund - late delivery"), matching this schema's existing
  /// precedent for "why did this happen" fields on Order
  /// (`rejectionReason`, `adminNote`) — both free String?, not a
  /// constrained enum, because refund reasons are as varied as support
  /// tickets and a fixed value set would just grow an "OTHER" bucket anyway.
  reason            String?
  /// PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED. String, not a
  /// native Prisma enum — matching every other lifecycle-status column in
  /// this schema (`Order.status`, `OrderItem.status`,
  /// `Denomination.deliveryType`). The state machine that governs these
  /// transitions lives in `REFUND_LEGAL_TRANSITIONS`
  /// (packages/db/src/crud/refunds.ts), validated by
  /// `transitionRefundStatus`. Reaching COMPLETED via `transitionRefundStatus`
  /// is record-keeping only — it does NOT call `adjustWallet` or trigger any
  /// payout; see that file's module comment. This is enforced, not just
  /// documented: `transitionRefundStatus` requires a caller to pass
  /// `acknowledgeNoPayout: true` to reach COMPLETED at all, and its audit log
  /// entry for that transition states "Record-keeping only — no payout was
  /// triggered by this transition." The only payout path wired up today is
  /// `refundUnderpaidOrder` (packages/db/src/crud/binance_internal.ts), and
  /// it writes its Refund row directly (bypassing `transitionRefundStatus`)
  /// at the same time it performs its own wallet credit, rather than driving
  /// this state machine.
  status            String    @default("PENDING")
  /// The refund's OWN external reference at whatever rail actually pays it
  /// out (e.g. a payment gateway's refund-transaction id, or a manual note
  /// an admin types when reconciling a bank-transfer refund) — distinct
  /// from the ORIGINAL payment's reference, which is deliberately NOT
  /// duplicated here. This repo has no single `Payment` table to point a
  /// typed `paymentId` FK at (6 different payment rails, tracked
  /// differently — some directly on `Order` via
  /// `paymentRef`/`binanceTxid`/`bybitTxid`, others via dedicated
  /// `Processed*Tx` ledger tables), and every one of those original-payment
  /// identifiers is already reachable through `orderId` -> `Order`, so a
  /// second column holding the same reference again would be pure
  /// duplication with a staleness risk if the Order row it copied from were
  /// ever corrected. Nullable: not every refund path will have an external
  /// reference (e.g. a pure wallet-credit refund settled entirely inside
  /// this DB).
  externalReference String?   @map("external_reference")
  /// Set when this Refund reaches a terminal state (COMPLETED, FAILED, or
  /// CANCELLED) — mirrors `Order.paidAt`/`Order.deliveredAt`'s pattern of a
  /// nullable timestamp that means "not yet reached this milestone", not
  /// "when the row was created" (that's `createdAt` below).
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Restrict, not Cascade (matches WalletTransaction/OrderStatusHistory/
  // Referral/Review's existing policy for Order-adjacent financial-audit
  // rows, Infra-5 fix, security audit 2026-06-23): a Refund is itself a
  // financial-audit record — deleting the Order it refunds must never
  // silently erase it. No code path hard-deletes an Order today; this is a
  // schema-level guardrail against ever adding one.
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items             RefundItem[]
  adminTasks        AdminTask[]
  /// The actual payout attempts for this Refund (Financial Ledger M1). A
  /// Refund reaching COMPLETED is record-keeping only and moves no money —
  /// see this model's `status` doc comment above; a RefundExecution row is
  /// where a payout is actually recorded. One-to-many because a failed
  /// attempt does not reopen the Refund, so a second attempt is a new row.
  executions        RefundExecution[]
  /// The stock-replacement requests that ended in THIS refund instead of a
  /// replacement credential (Financial Ledger M18) — i.e. rows whose status is
  /// REFUNDED_INSTEAD. Empty for every refund raised for any other reason.
  stockReplacements StockReplacement[]

  @@index([orderId], map: "ix_refunds_order_id")
  @@index([status], map: "ix_refunds_status")
  @@map("refunds")
}

/// Per-item breakdown of a Refund, for partial refunds (qty>1 premium items,
/// or multi-item premium carts) where only some units/lines of an order are
/// being refunded — e.g. buy 3 Netflix accounts, one turns out dead.
///
/// INVARIANT (enforced at the APPLICATION layer, NOT here): the sum of
/// `amount` across every RefundItem row for a given `orderItemId` must never
/// exceed that OrderItem's own subtotal (`unitPrice * quantity`, in the same
/// currency as the original payment). A CHECK constraint can't
/// express a cross-row aggregate like "sum of sibling rows", so this schema
/// only provides the pieces the application-layer check needs — the
/// `orderItemId` FK to group by, and the `amount` column to sum. The actual
/// enforcement (reading existing RefundItem rows for that orderItemId before
/// inserting a new one, excluding rows whose parent Refund is CANCELLED or
/// FAILED since those never consumed the budget) is `createRefundItem`
/// (packages/db/src/crud/refunds.ts). Do not assume this invariant holds
/// just because the schema exists — go read that function if you need to
/// verify current behavior.
model RefundItem {
  id          Int      @id @default(autoincrement())
  refundId    Int      @map("refund_id")
  orderItemId Int      @map("order_item_id")
  amount      Decimal
  /// Same snapshot-at-creation-time reasoning as `Refund.currency` above —
  /// copied from the parent Refund's currency (and transitively from
  /// Order.currency), not derived by joining back on read.
  currency    String
  /// Free-text, same precedent as `Refund.reason` — lets a per-item refund
  /// carry its own explanation distinct from the parent Refund's overall
  /// reason (e.g. parent reason "partial refund - 1 of 3 dead", this row's
  /// reason "account banned within 24h, screenshot on ticket #482").
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Restrict, not Cascade, for two independent reasons layered on the same
  // policy (Infra-5, security audit 2026-06-23):
  //  - orderItem: never let the OrderItem this refund is FOR be silently
  //    erased out from under an existing refund record — same guardrail as
  //    every other Order-adjacent financial-audit row in this schema.
  //  - refund: RefundItem is itself financial-audit-significant (it's the
  //    per-line detail of a Refund, same category as Refund itself), and no
  //    code path deletes a Refund either — so it gets the same conservative
  //    policy as its parent, not the looser Cascade some non-financial
  //    detail tables use elsewhere (e.g. TicketMessage -> SupportTicket).
  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([refundId], map: "ix_refund_items_refund_id")
  @@index([orderItemId], map: "ix_refund_items_order_item_id")
  @@map("refund_items")
}

/// Multi-attempt payment ledger (Trustance Phase A Task A2a) — one row per
/// payment ATTEMPT for an Order, coexisting with (not replacing) the payment
/// fields directly on Order (paymentMethod, paymentRef, binanceTxid,
/// bybitTxid, ...). Those Order fields stay the "current/latest attempt"
/// cache the six existing payment-rail webhook/poller handlers
/// (binance_internal.ts, bybit_deposit.ts, bybit_bsc_deposit.ts,
/// nowpaymentsReconcile.ts, tokopayReconcile.ts, paydisiniReconcile.ts) read
/// directly and unchanged — wiring those six handlers to also write to THIS
/// table is a separate follow-up task, out of scope for the model/crud/entry-
/// point this migration adds. Before this model, this repo had no single
/// Payment table to point a typed FK at (see Refund.externalReference's own
/// doc comment); this is that table, purpose-built for one thing the Order
/// fields alone can't express — a buyer switching payment rails on the SAME
/// order without abandoning it and creating a whole new Order (see
/// "change payment rail", apps/order-bot/src/handlers/checkout.ts).
///
/// INVARIANT: an Order may have at most one PENDING Payment row at a time.
///
/// A first design pass tried enforcing this with a Postgres PARTIAL unique
/// index (`CREATE UNIQUE INDEX ... ON "payments"("order_id") WHERE "status" =
/// 'PENDING'`) hand-appended to this feature's migration SQL, since Prisma's
/// schema DSL has no syntax for a partial/conditional unique index at all
/// (verified: `@@unique` always constrains every row, no WHERE clause
/// available). That approach was ABANDONED after verifying it against this
/// repo's actual deploy mechanism (docs/MIGRATIONS.md: "`db push`, bukan
/// `migrate deploy`" — `db push` diffs schema.prisma -> DB directly and is
/// the ONLY thing every dev/CI/staging/prod environment here actually runs;
/// `prisma/migrations/*` is audit-trail documentation, not an applied
/// history). Hand-written SQL that exists ONLY in a migration file is dead
/// documentation under that mechanism — `tests/helpers/testdb.ts` proved this
/// empirically: it provisions each test's schema via `db push`, so a partial
/// index invisible to schema.prisma silently never existed in ANY test run,
/// and a true-concurrency test written against it caught 5-for-5 inserts
/// succeeding instead of 1 (see payments.test.ts's git history / task
/// report). The exact same gap would exist in dev/staging/prod.
///
/// A single-row `updateMany`-with-guard claim (this schema's other
/// concurrency-safety precedent, `claimGatewaySlot` in
/// packages/db/src/crud/orders.ts) doesn't fit either: that pattern
/// atomically compare-and-swaps a value on ONE already-existing row, whereas
/// this invariant is over INSERTING a new sibling row conditioned on the
/// absence of another — under Postgres' default READ COMMITTED isolation, a
/// plain read-then-insert check (no matter how it's phrased, including a
/// single `INSERT ... WHERE NOT EXISTS (...)` statement) lets two concurrent
/// transactions each see "no PENDING row yet" and both insert.
///
/// The mechanism actually used: `pendingOrderId` below is a nullable column
/// that mirrors `orderId` while (and only while) `status` is PENDING, and is
/// cleared back to `null` the instant a row leaves PENDING (EXPIRED/
/// CONFIRMED/FAILED). A plain, FULL `@unique` index on it — ordinary Prisma
/// DSL, created automatically by `db push` in every environment, no hand SQL
/// anywhere — then enforces the invariant: Postgres unique indexes treat
/// every NULL as distinct from every other NULL (default `NULLS DISTINCT`
/// behavior, unchanged since this repo targets it), so any number of
/// non-PENDING rows (`pendingOrderId: null`) coexist freely, while a second
/// row trying to set `pendingOrderId` to an order id that's already claimed
/// raises a genuine unique-constraint violation (Postgres 23505, surfaced by
/// Prisma as P2002). This is the SAME nullable+unique claim-column shape this
/// schema already uses twice on `Order` itself (`paymentRef`,
/// `checkoutIntentId`) — not a new pattern, just applied to a new table.
/// `createPaymentAttempt` (packages/db/src/crud/payments.ts) sets
/// `pendingOrderId: orderId` on insert and translates the resulting P2002
/// into a clean `ValidationError`; `expirePaymentAttempt`/
/// `confirmPaymentAttempt` clear it to `null` in the same atomic
/// `updateMany`-with-guard call that moves `status` off PENDING.
model Payment {
  id                    Int       @id @default(autoincrement())
  orderId               Int       @map("order_id")
  /// PaymentMethod value (@app/core/enums) — free String, not a native Prisma
  /// enum, matching Order.paymentMethod's own column and every other
  /// lifecycle-status-adjacent column in this schema.
  method                String
  /// PENDING | CONFIRMED | EXPIRED | FAILED (PaymentStatus, @app/core/enums).
  /// See this model's own doc comment for the transition shape and the
  /// at-most-one-PENDING-per-order invariant.
  status                String    @default("PENDING")
  /// This attempt's own external reference at whatever rail it's for (e.g. a
  /// gateway transaction id, a Binance Internal Transfer note) — same
  /// "external reference" role as Refund.externalReference, just for the
  /// payment side. Independent of Order.paymentRef (which is only ever the
  /// CURRENT attempt's reference) — an EXPIRED attempt here keeps its OWN
  /// reference even after a rail change moves Order.paymentRef on.
  reference             String?
  /// This attempt's own quoted amount, snapshotted at creation time — same
  /// snapshot-at-creation-time reasoning as Refund.amount/RefundItem.amount
  /// (their own doc comments) — later Order edits must never retroactively
  /// change what a past attempt quoted. Decimal, never Float (CLAUDE.md money
  /// rule; matches every other money column in this schema, e.g.
  /// Refund.amount, Order.totalAmount).
  amount                Decimal
  /// Snapshot of the currency this attempt was quoted in — same
  /// snapshot-at-creation-time reasoning as `amount` above and
  /// Refund.currency's own doc comment.
  currency              String
  createdAt             DateTime  @default(now()) @map("created_at")
  /// Set together with `expiryReason` the moment this attempt reaches
  /// EXPIRED — mirrors Refund.processedAt's nullable-until-terminal pattern.
  expiredAt             DateTime? @map("expired_at")
  /// Set the moment this attempt reaches CONFIRMED.
  confirmedAt           DateTime? @map("confirmed_at")
  /// Set only when `status` reaches EXPIRED — "RAIL_CHANGED" | "TIMEOUT" |
  /// "CANCELLED" (PaymentExpiryReason, @app/core/enums). Null for every
  /// PENDING/CONFIRMED/FAILED row.
  expiryReason          String?   @map("expiry_reason")
  /// Mirrors `orderId` while (and only while) `status` is PENDING; `null`
  /// for every non-PENDING row. See this model's own doc comment — the
  /// `@unique` index below on this column, not a partial index on `orderId`,
  /// is what enforces "at most one PENDING Payment per order".
  pendingOrderId        Int?      @unique(map: "ix_payments_pending_order_id") @map("pending_order_id")
  /// The gateway's OWN id for the underlying transaction, as distinct from
  /// `reference` above (Financial Ledger M1). `reference` is whatever this
  /// shop quoted or showed for the attempt — a Tokopay merchant ref, a Binance
  /// transfer note — and is chosen by US; this column is chosen by THEM, and
  /// is the id that appears on the provider's settlement report. Reconciling a
  /// Settlement batch means matching its lines on this column, which is why it
  /// needs its own uniqueness guarantee rather than reusing `reference`.
  ///
  /// Nullable, and deliberately so: every row that predates this column has it
  /// null, and no backfill is possible (the six existing payment-rail handlers
  /// never captured it). The `@@unique([method, providerTransactionId])` below
  /// is therefore safe to add with no backfill — Postgres unique indexes treat
  /// every NULL as distinct from every other NULL (default `NULLS DISTINCT`),
  /// exactly the same property `pendingOrderId` above already relies on, so
  /// any number of null rows coexist freely. Scoped by `method` rather than
  /// global because two different providers can legitimately issue the same
  /// transaction id string, and a collision between them is not a duplicate.
  providerTransactionId String?   @map("provider_transaction_id")
  /// The provider's cut for this payment, in `currency` — what the gateway
  /// kept, not what the buyer paid. Decimal, never Float (CLAUDE.md money
  /// rule; matches every other money column in this schema). Null means "not
  /// known", which is every row today and every row on a rail that does not
  /// report a fee — NOT "the fee was zero"; a genuinely free payment stores 0.
  fee                   Decimal?
  /// `gross paid - fee`: what actually reaches this shop's own cash account,
  /// in `currency`. NOT always `amount - fee` — `amount` is this shop's own
  /// quoted/order-total figure, which on a rail whose fee is a buyer-side
  /// surcharge (added ON TOP of `amount`, not deducted from it) already
  /// equals the net, making `netAmount == amount` correct on that rail (see
  /// TokoPay's `computeQrisAdminFee`). Stored rather than derived so the
  /// settlement side reads what actually happened instead of recomputing it
  /// from two other columns (which would silently disagree with a rail's own
  /// arithmetic over rounding, or over which side of the transaction the fee
  /// was charged on). Null on the same rows `fee` is null.
  netAmount             Decimal?  @map("net_amount")

  // Restrict, not Cascade — matches every other Order-adjacent
  // financial-audit row in this schema (WalletTransaction/
  // OrderStatusHistory/Refund/RefundItem, Infra-5 fix, security audit
  // 2026-06-23): no code path hard-deletes an Order today; this is a
  // schema-level guardrail against ever adding one that would silently erase
  // payment-attempt history.
  order                  Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  settlementTransactions SettlementTransaction[]

  @@unique([method, providerTransactionId], map: "ix_payments_method_provider_txn")
  @@index([orderId], map: "ix_payments_order_id")
  @@index([status], map: "ix_payments_status")
  @@map("payments")
}

/// Manual-operation task queue (Trustance Master Architecture Task 9a, §38):
/// "manual operation must become a task" — a persisted, assignable,
/// admin-worked queue item, distinct from the read-only, live-derived
/// counters `GET /api/dashboard/operations` computes directly from
/// Order/Payment-adjacent tables (apps/web-admin/src/routes/api/dashboard.ts,
/// OperationCenter.tsx). That endpoint answers "how many X are pending right
/// now"; AdminTask answers "who is working this specific one, and what
/// state is it in" — the two are not merged, and OperationCenter does not
/// read this table (a later task may wire it to link into an AdminTask queue
/// UI, out of scope here).
///
/// `type` — REQUEST_CUSTOMER_INFO | MANUAL_DELIVERY |
/// MANUAL_ACCOUNT_ASSIGNMENT | FAILED_TOPUP_REVIEW | REFUND_REVIEW
/// (AdminTaskType, @app/core/enums). String, not a native Prisma enum —
/// matches every other lifecycle-status-adjacent column in this schema
/// (Order.status, OrderItem.status, Refund.status).
model AdminTask {
  id Int @id @default(autoincrement())

  type String

  /// Both independently nullable, mirroring SupportTicket's identical
  /// orderId?/nothing-else-required shape: a task can be about a whole order
  /// (e.g. MANUAL_DELIVERY for a whole-order manual product) or a specific
  /// line within it (e.g. FAILED_TOPUP_REVIEW for one Digiflazz-routed item
  /// in a multi-item cart). Neither is required — a task type that needs no
  /// order context is representable, same as a general SupportTicket.
  orderId     Int? @map("order_id")
  orderItemId Int? @map("order_item_id")
  /// Optional link to the specific Refund a REFUND_REVIEW task is about.
  /// Not in the master-architecture field list verbatim, but added because
  /// an Order can carry more than one Refund (partial/multiple refund
  /// requests over time — see RefundItem's cross-refund budget invariant) —
  /// without this, a REFUND_REVIEW task pointed only at `orderId` would
  /// leave an admin to guess which of the order's Refund rows is under
  /// review. Optional/nullable like every other reference field here; every
  /// other task `type` is expected to leave this null.
  refundId    Int? @map("refund_id")

  /// Acting admin this task is currently assigned to — same "which admin did
  /// this" convention as SupportTicket.adminId/AuditLog.adminId: a plain
  /// nullable FK to User (this repo's admins are User rows with
  /// role=ADMIN, not a separate Admin table), NoAction on delete (matches
  /// SupportTicket.admin/AuditLog.admin, not the Restrict policy used for
  /// order/orderItem/refund below — those are the audit-significant parent
  /// rows this task is ABOUT, whereas assignedTo is only "who is currently
  /// working it" and losing that pointer if the admin row were ever removed
  /// is not the same category of data loss).
  assignedTo Int? @map("assigned_to")

  /// LOW | MEDIUM | HIGH | URGENT (AdminTaskPriority, @app/core/enums) —
  /// same vocabulary as SupportTicket.priority, defaults MEDIUM.
  priority String @default("MEDIUM")

  /// PENDING | ASSIGNED | IN_PROGRESS | ESCALATED | COMPLETED
  /// (AdminTaskStatus, @app/core/enums). The state machine that governs
  /// these transitions — driven by the four admin actions in §38 (Assign /
  /// Start / Complete / Escalate) — lives in `ADMIN_TASK_LEGAL_TRANSITIONS`
  /// (packages/db/src/crud/adminTasks.ts), validated by
  /// `transitionAdminTaskStatus`.
  status String @default("PENDING")

  dueAt       DateTime? @map("due_at")
  /// Set once, when this task reaches COMPLETED — mirrors
  /// Refund.processedAt's "not yet reached this milestone" pattern.
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // orderId/orderItemId/refundId: Restrict, not Cascade — matches
  // Refund/RefundItem's existing conservative FK policy for every other
  // Order-adjacent financial/operational-audit row (Infra-5 fix, security
  // audit 2026-06-23). An AdminTask is itself an operational-audit record;
  // no code path hard-deletes an Order/OrderItem/Refund today, and this is a
  // schema-level guardrail against ever adding one that would silently
  // orphan a task record.
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refund    Refund?    @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // assignedTo: NoAction, matching SupportTicket.admin/AuditLog.admin's
  // existing "acting admin" FK policy (not Restrict) — see the field's own
  // doc comment above for why this one FK is deliberately not Restrict.
  assignee  User?      @relation("AdminTaskAssignee", fields: [assignedTo], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "ix_admin_tasks_status")
  @@index([type], map: "ix_admin_tasks_type")
  @@index([assignedTo], map: "ix_admin_tasks_assigned_to")
  @@index([orderId], map: "ix_admin_tasks_order_id")
  @@index([orderItemId], map: "ix_admin_tasks_order_item_id")
  @@index([refundId], map: "ix_admin_tasks_refund_id")
  @@map("admin_tasks")
}

model Voucher {
  id          Int       @id @default(autoincrement())
  code        String    @unique(map: "ix_vouchers_code")
  type        String
  value       Decimal
  usageLimit  Int?      @map("usage_limit")
  usedCount   Int       @default(0) @map("used_count")
  minPurchase Decimal   @default(0) @map("min_purchase")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  scope       String    @default("ALL") @map("scope")
  maxDiscount Decimal?  @map("max_discount")
  startAt     DateTime? @map("start_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  orders          Order[]
  redemptions     VoucherRedemption[]
  voucherProducts VoucherProduct[]

  @@map("vouchers")
}

/// One row per (voucher, user) the first time that user redeems that voucher —
/// the unique index is the per-user usage cap (1x/voucher/user), enforced
/// atomically alongside order creation so concurrent checkouts can't both slip
/// through a check-then-insert race (security audit Pricing-1, 2026-06-23).
model VoucherRedemption {
  id        Int      @id @default(autoincrement())
  voucherId Int      @map("voucher_id")
  userId    Int      @map("user_id")
  orderId   Int      @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([voucherId, userId], map: "ix_voucher_redemptions_voucher_user")
  @@index([orderId], map: "ix_voucher_redemptions_order_id")
  @@map("voucher_redemptions")
}

model VoucherProduct {
  id        Int @id @default(autoincrement())
  voucherId Int @map("voucher_id")
  productId Int @map("product_id")

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([voucherId, productId], map: "ix_voucher_products_voucher_product")
  @@index([productId], map: "ix_voucher_products_product_id")
  @@map("voucher_products")
}

model Review {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  /// Holds a denomination id (column kept as `product_id` to avoid a rename).
  productId        Int       @map("product_id")
  orderId          Int       @map("order_id")
  rating           Int
  comment          String?
  hidden           Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")
  /// Reply-workflow state, orthogonal to `hidden` (visibility) — PENDING_REPLY |
  /// REPLIED | CLOSED (spec §11). `hidden` still governs whether the review
  /// shows up to customers; this tracks whether an admin owes the reviewer a
  /// response.
  status           String    @default("PENDING_REPLY")
  /// Provenance — CUSTOMER | SYSTEM_AUTO. Every Phase-A row is CUSTOMER;
  /// SYSTEM_AUTO is reserved for the deferred auto-review job (Phase B) so
  /// that feature needs no further migration.
  source           String    @default("CUSTOMER")
  /// POSITIVE | NEUTRAL | NEGATIVE — computed once at creation time and
  /// persisted (not derived on read) so it stays filterable/aggregatable.
  sentiment        String    @default("NEUTRAL")
  /// Admin's reply text, shown back to the reviewer. Named to match
  /// SupportTicket's adminReply/repliedAt/adminId trio for convention
  /// consistency.
  adminReply       String?   @map("admin_reply")
  repliedAt        DateTime? @map("replied_at")
  repliedByAdminId Int?      @map("replied_by_admin_id")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // `product` resolves to a Denomination (SKU); renamed in Phase 5 cleanup.
  product        Denomination @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // Restrict, not Cascade (Infra-5 fix, security audit 2026-06-23): a review
  // is tied to its order for verified-purchase provenance — deleting an
  // Order must never silently erase that record. No code path hard-deletes
  // an Order today; this is a schema-level guardrail against ever adding one.
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // Named relation (mirrors SupportTicket's "TicketAdmin"): Review already has
  // an unnamed `user` relation to User (the reviewer), so the admin-who-replied
  // relation needs its own name to disambiguate.
  repliedByAdmin User?        @relation("ReviewRepliedByAdmin", fields: [repliedByAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, orderId])
  @@index([productId], map: "ix_reviews_product_id")
  @@index([status], map: "ix_reviews_status")
  @@map("reviews")
}

model Referral {
  id         Int      @id @default(autoincrement())
  referrerId Int      @map("referrer_id")
  refereeId  Int      @unique @map("referee_id")
  orderId    Int      @map("order_id")
  commission Decimal
  paid       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  // Restrict, not Cascade (Infra-5 fix, security audit 2026-06-23): this row
  // is the commission ledger — deleting the underlying Order must never
  // silently erase it. No code path hard-deletes an Order today; this is a
  // schema-level guardrail against ever adding one.
  order    Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  referee  User  @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  referrer User  @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([referrerId], map: "ix_referrals_referrer_id")
  @@map("referrals")
}

model SupportTicket {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  message            String
  photoFileIds       String?   @map("photo_file_ids")
  attachmentUrls     String?   @map("attachment_urls")
  status             String    @default("OPEN")
  /// LOW | MEDIUM | HIGH | URGENT — admin-set triage field, defaults MEDIUM.
  priority           String    @default("MEDIUM") @map("priority")
  /// Ticket triage category. Customer-set at creation on the /help create
  /// form; may also be set/changed later by an admin via classifyTicket.
  /// Null for legacy rows created before either path existed.
  category           String?   @map("category")
  /// Short customer-authored ticket title (≤100 chars), set on the /help
  /// create form. Nullable: historical rows created before this column
  /// existed have none — the storefront falls back to the first line of
  /// `message` for display.
  subject            String?   @map("subject")
  adminReply         String?   @map("admin_reply")
  adminId            Int?      @map("admin_id")
  /// TCK-YYYYMMDD-NNNNN, minted once at creation (createTicket/
  /// uniqueTicketNumberCandidate) — nullable because `db push` never
  /// backfills historical rows created before this column existed (same
  /// reasoning as OrderItem.deliveryTypeSnapshot / this model's own
  /// lastStatusChangeAt above). Admin UI must fall back to `#id` for rows
  /// where this is null.
  ticketNumber       String?   @unique @map("ticket_number")
  /// Set together with `assignedBy` by the assignment-with-audit-trail path
  /// (see `assignedBy`'s own comment) — when this ticket's `adminId` (the
  /// admin CURRENTLY working it) was last explicitly assigned.
  assignedAt         DateTime? @map("assigned_at")
  /// The admin who PERFORMED an assignment action — distinct from `adminId`
  /// (who the ticket is assigned TO / is currently working it). E.g. a lead
  /// admin assigns a ticket to a junior admin: `adminId` becomes the junior
  /// admin's id, `assignedBy` stays the lead admin's id. Nullable: most
  /// existing tickets were never assigned through this audited path (the
  /// plain `adminId`-only assign predates it).
  assignedBy         Int?      @map("assigned_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  repliedAt          DateTime? @map("replied_at")
  /// Set once, the first time an admin message lands on the ticket — true
  /// first-response time, unlike repliedAt which is overwritten on every reply.
  firstResponseAt    DateTime? @map("first_response_at")
  /// Set once, when an admin marks the ticket RESOLVED (distinct from CLOSED).
  resolvedAt         DateTime? @map("resolved_at")
  /// Optional link to the order this ticket is about — customer-picked at
  /// creation time. Null for general-purpose tickets (account issues,
  /// pre-purchase questions). Unlocks the storefront ticket page's Order/
  /// Product Summary sidebar and warranty/credential context.
  orderId            Int?      @map("order_id")
  /// Optional link to the catalog Product this ticket is about — customer-
  /// picked on the /help create form. Distinct from `orderId` (a specific
  /// past purchase); this is "which product", set even for pre-purchase
  /// questions. Null for general tickets.
  productId          Int?      @map("product_id")
  /// Bumped on every status transition (open/replied/resolved/closed/reopened)
  /// — the operational queue's "waiting time" and overdue calc read this, not
  /// createdAt, so a reopened ticket's wait clock resets correctly.
  lastStatusChangeAt DateTime  @default(now()) @map("last_status_change_at")
  /// Set once, when `closeTicket` flips status -> CLOSED. Drives the storage
  /// cleanup job's "delete evidence N days after close" eligibility check.
  /// Nullable, no default.
  closedAt           DateTime? @map("closed_at")

  user              User               @relation("TicketUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin             User?              @relation("TicketAdmin", fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // Same "who acted, not who this row is about" reasoning as TicketAdmin
  // above (and AdminTask.assignee / Review.repliedByAdmin) — NoAction on
  // delete, not Restrict: losing the assigner pointer if that admin's User
  // row were ever removed is not the same category of data loss as losing
  // the order/customer this ticket is about.
  assignedByAdmin   User?              @relation("TicketAssignedBy", fields: [assignedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order             Order?             @relation(fields: [orderId], references: [id], onUpdate: NoAction)
  product           Product?           @relation(fields: [productId], references: [id], onUpdate: NoAction)
  messages          TicketMessage[]
  /// Stock-replacement requests that arrived on this ticket (Financial Ledger
  /// M18). Empty for tickets that never led to one, and a replacement recorded
  /// from another channel has no ticket at all.
  stockReplacements StockReplacement[]

  @@index([userId], map: "ix_support_tickets_user_id")
  @@index([closedAt], map: "ix_support_tickets_closed_at")
  @@index([orderId], map: "ix_support_tickets_order_id")
  @@index([productId], map: "ix_support_tickets_product_id")
  @@index([status], map: "ix_support_tickets_status")
  @@index([priority], map: "ix_support_tickets_priority")
  @@map("support_tickets")
}

