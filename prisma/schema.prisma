model NotificationOutbox {
  id          Int       @id @default(autoincrement())
  event       String
  /// Transport for this row — TELEGRAM | EMAIL. Explicit row data rather than
  /// inferred from the event name: the dispatcher used to derive DM-vs-channel
  /// purely from the `ADMIN_DM_EVENTS` name Set (dispatcher.ts), which has no
  /// notion of a second transport. Defaults to TELEGRAM so every existing row
  /// and every existing `enqueue*` call site keeps working untouched.
  channel     String    @default("TELEGRAM") @map("channel")
  payloadJson String    @map("payload_json")
  orderId     Int?      @map("order_id")
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  sentAt      DateTime? @map("sent_at")
  /// Set when a row is atomically claimed (PENDING/stale-SENDING -> SENDING)
  /// right before a send attempt — the crash-window double-send guard
  /// (Infra-2 fix, security audit 2026-06-23). A row stuck SENDING past the
  /// stale-claim window is reclaimable again (the dispatcher process died
  /// mid-send before reaching markNotificationSent/Failed).
  claimedAt   DateTime? @map("claimed_at")
  /// Exponential backoff for a row markNotificationFailed put back to
  /// PENDING — null/past means immediately claimable. Without this, a
  /// permanently-failing row (bad chat_id, malformed payload) keeps the
  /// oldest `createdAt` and re-occupies the batch's limited "top N" slot
  /// every tick until max-attempts, starving valid rows enqueued after it
  /// (Infra-3 fix, security audit 2026-06-23).
  nextRetryAt DateTime? @map("next_retry_at")
  /// Optional caller-supplied idempotency key for "enqueue this row at most
  /// once". NULL for almost every row, and NULLs are distinct in a SQLite
  /// UNIQUE index, so unkeyed rows are unaffected and may repeat freely —
  /// which is what the per-admin fan-out events (ADMIN_OVERPAID,
  /// ORDER_PIPELINE_FAILED, ADMIN_MANUAL_ORDER_QUEUED, ADMIN_STALE_PAYMENT)
  /// and the per-recipient broadcasts need. `enqueueNotification` treats the
  /// UNIQUE violation as a successful no-op, so a key turns "enqueued exactly
  /// once" from a property of where the call sits into one the database
  /// holds. Only two events set it today; see `enqueueNotification`'s own
  /// doc-comment for which, and for why ORDER_DELIVERED_DM deliberately
  /// does not.
  dedupeKey   String?   @unique(map: "ix_notification_outbox_dedupe_key") @map("dedupe_key")

  order Order? @relation(fields: [orderId], references: [id], onUpdate: NoAction)

  @@index([status, createdAt], map: "ix_notif_status_created")
  @@index([orderId], map: "ix_notification_outbox_order_id")
  @@index([status], map: "ix_notification_outbox_status")
  @@index([createdAt], map: "ix_notification_outbox_created_at")
  @@map("notification_outbox")
}

/// Idempotency ledger for Binance Internal Transfer auto-confirmation.
/// Every Binance transaction the poller inspects is recorded here exactly once;
/// the UNIQUE binance_tx_id is what prevents double-processing / double-delivery
/// (SQLite has no row locking, so the insert-first-on-unique pattern is the
/// concurrency guard — see payments/binanceInternal.ts).
/// Broadcast queue — the web ENQUEUES here; the order-bot drains and sends
/// (the web never calls Telegram). One row = one broadcast to a segment.
model Broadcast {
  id          Int       @id @default(autoincrement())
  message     String
  segment     String // ALL | RESELLERS | RECENT_BUYERS
  status      String    @default("PENDING") // DRAFT | PENDING | SENDING | SENT | CANCELLED | FAILED
  scheduledAt DateTime? @map("scheduled_at") // null = send asap
  createdById Int?      @map("created_by_id") // acting web admin (user id)
  totalCount  Int       @default(0) @map("total_count") // recipients at enqueue (display)
  sentCount   Int       @default(0) @map("sent_count")
  failedCount Int       @default(0) @map("failed_count")
  webImageUrl String?   @map("web_image_url") // optional attached image, /uploads/broadcasts/... path
  imageFileId String?   @map("image_file_id") // cached Telegram file_id, resolved on first sendPhoto
  claimedAt     DateTime? @map("claimed_at")      // NEW — set when claimNextDueBroadcast flips PENDING→SENDING
  failureReason String?   @map("failure_reason")  // NEW — set when a row is marked FAILED
  createdAt   DateTime  @default(now()) @map("created_at")
  sentAt      DateTime? @map("sent_at")

  @@index([status], map: "ix_broadcasts_status")
  @@map("broadcasts")
}

model ProcessedBinanceTx {
  id          Int      @id @default(autoincrement())
  binanceTxId String   @unique(map: "ix_processed_binance_tx_txid") @map("binance_tx_id")
  orderId     Int?     @map("order_id")
  amount      Decimal?
  // matched | underpaid | unmatched
  outcome     String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderId], map: "ix_processed_binance_tx_order_id")
  @@map("processed_binance_tx")
}

/// Idempotency ledger for Bybit USDT-BSC deposits — same insert-first-on-unique
/// pattern as ProcessedBinanceTx. The on-chain txID (a 0x… hash) is claimed
/// exactly once, so repeated poll cycles can never double-deliver. BEP20 carries
/// no memo, so there is no underpaid auto-path (an amount that matches no order
/// is simply "unmatched"); outcome is matched | unmatched | delivery_failed.
model ProcessedBybitTx {
  id        Int      @id @default(autoincrement())
  bybitTxId String   @unique(map: "ix_processed_bybit_tx_txid") @map("bybit_tx_id")
  orderId   Int?     @map("order_id")
  amount    Decimal?
  outcome   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId], map: "ix_processed_bybit_tx_order_id")
  @@map("processed_bybit_tx")
}

/// Idempotency ledger for TokoPay webhook callbacks (the IDR payment path) —
/// same insert-first-on-unique pattern as ProcessedBinanceTx: a callback's
/// reference id is claimed exactly once, so repeated callbacks can never
/// double-deliver an order (plan.md §15.5).
model ProcessedTokopayTx {
  id        Int      @id @default(autoincrement())
  trxId     String   @unique(map: "ix_processed_tokopay_tx_trxid") @map("trx_id")
  orderId   Int?     @map("order_id")
  amount    Decimal?
  // matched | unmatched | delivery_failed
  outcome   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId], map: "ix_processed_tokopay_tx_order_id")
  @@map("processed_tokopay_tx")
}

/// Idempotency ledger for PayDisini (QRIS/e-wallet, IDR) webhook callbacks —
/// same insert-first-on-unique pattern as ProcessedTokopayTx.
model ProcessedPaydisiniTx {
  id        Int      @id @default(autoincrement())
  trxId     String   @unique(map: "ix_processed_paydisini_tx_trxid") @map("trx_id")
  orderId   Int?     @map("order_id")
  amount    Decimal?
  // matched | unmatched | delivery_failed | stale
  outcome   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId], map: "ix_processed_paydisini_tx_order_id")
  @@map("processed_paydisini_tx")
}

/// Idempotency ledger for NOWPayments (USDT crypto invoice) IPN callbacks —
/// same insert-first-on-unique pattern. trxId stores NOWPayments' payment_id.
model ProcessedNowpaymentsTx {
  id        Int      @id @default(autoincrement())
  trxId     String   @unique(map: "ix_processed_nowpayments_tx_trxid") @map("trx_id")
  orderId   Int?     @map("order_id")
  amount    Decimal?
  // matched | unmatched | delivery_failed | stale
  outcome   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId], map: "ix_processed_nowpayments_tx_order_id")
  @@map("processed_nowpayments_tx")
}

/// Records the amount actually received for a QRIS/IDR order (TokoPay,
/// PayDisini, NOWPayments) flagged UNDERPAID by markOrderUnderpaid
/// (packages/db/src/crud/orderStatus.ts). Unlike the crypto rails'
/// Processed*Tx ledgers, this is not a delivery-dedup table — these three
/// gateways dedupe via the order's own status (see markOrderUnderpaid's
/// doc comment) — it exists solely so findUnderpaidReceived (orders.ts)
/// can read back a structured amount instead of the adminNote free-text
/// note that was the only record before this table existed.
model QrisUnderpaidTx {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique @map("order_id")
  gateway        String
  receivedAmount Decimal  @map("received_amount")
  expectedAmount Decimal  @map("expected_amount")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("qris_underpaid_tx")
}

/// Idempotency ledger for Telegram update_id redelivery — same insert-first-
/// on-unique pattern as the Processed*Tx ledgers above, but for a different
/// kind of duplicate: Telegram's long-polling `getUpdates` offset only
/// advances once a batch is fully acknowledged, so a crash mid-processing
/// (before the next poll) — or a flaky connection — redelivers the same
/// update_id on restart/retry. `bindUpdateId` (apps/order-bot/src/middleware.ts)
/// claims a row here before running the rest of the update's middleware
/// chain, so a redelivered update short-circuits instead of re-running a
/// side effect (charging a wallet, sending a duplicate DM, ...) a second
/// time. Short-lived by design — unlike the payment ledgers above (which
/// storageMaintenance.ts deliberately leaves alone), a row here is only ever
/// useful for as long as Telegram might still redeliver the same update_id
/// (minutes, not months) — see pruneProcessedTelegramUpdates
/// (packages/db/src/crud/telegramUpdates.ts) and its daily cron
/// (jobs/index.ts) for the retention sweep that keeps this table small.
model ProcessedTelegramUpdate {
  id          Int      @id @default(autoincrement())
  updateId    BigInt   @unique(map: "ix_processed_telegram_update_update_id") @map("update_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_telegram_updates")
}

/// Client-side idempotency ledger for checkout/refund-style mutations — a
/// DIFFERENT mechanism from the Processed*Tx ledgers above (those dedupe an
/// inbound payment-gateway webhook callback; this dedupes a double-tapped or
/// retried request from a browser/admin client). The caller sends an
/// `Idempotency-Key` header; (key, endpoint) is claimed exactly once via the
/// unique index below. A retry with the same key AND the same requestHash
/// replays responseBody/statusCode verbatim instead of re-running the
/// mutation; the same key with a DIFFERENT hash means the key was reused for
/// a distinct request (a client bug) and is rejected with 409 rather than
/// silently replaying the wrong response or overwriting the original.
model IdempotencyRecord {
  id           Int      @id @default(autoincrement())
  key          String
  endpoint     String
  requestHash  String   @map("request_hash")
  responseBody String   @map("response_body")
  statusCode   Int      @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([key, endpoint], map: "ix_idempotency_record_key_endpoint")
  @@map("idempotency_records")
}

/// grammY session storage — replaces the old in-memory `boundedSessionStorage`
/// (an LRU `Map`, lost on every restart) with a real StorageAdapter<SessionData>
/// backed by this table (`apps/order-bot/src/util/prismaSessionStorage.ts`).
/// `key` is grammY's session key — this bot uses the default `getSessionKey`,
/// one row per chat id. `data` is `ctx.session` JSON.stringify'd; every value
/// that reaches this column MUST already be a plain JSON-serializable object —
/// see prismaSessionStorage.ts's header comment for the Phase B landmine
/// (a `conversation.external()` result carrying a function/closure survived
/// only because the old storage was an in-memory `Map`; a real serialization
/// boundary like this table would silently corrupt it) this migration's
/// conversation.external() audit exists to guard against.
///
/// `kind` ("nav" | "checkout") implements the plan's TTL split — a session
/// mid-checkout (payment anchor set, a voucher applied, info-collection in
/// progress, ...) expires after the longest configured payment window across
/// every rail plus a 5-minute margin (35 minutes at default config, clamped
/// to never exceed it), instead of the 24h a "just browsing" session gets —
/// so an abandoned checkout's stale state (e.g. a payment-message anchor
/// pointing at a bubble the buyer walked away from) doesn't linger a full
/// day, while never expiring under a payment that's still legitimately
/// pending. See prismaSessionStorage.ts's
/// `classifySessionKind` for the exact rule. `expiresAt` is recomputed and
/// re-stamped on every write (a still-active session keeps sliding its own
/// expiry forward); the index below backs the daily prune sweep
/// (`cleanupExpiredBotSessionsJob`, jobs/index.ts) — grammY's own read/write
/// only ever queries by `key`.
model BotSession {
  key       String   @id
  data      String
  kind      String
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt], map: "ix_bot_session_expires_at")
  @@map("bot_sessions")
}
