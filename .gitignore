# --- dependencies ---
node_modules/

# --- secrets / local env (NEVER commit) ---
.env
.env.*
!.env.example

# --- local MCP server config (token via ${HOSTINGER_API_TOKEN} env var) ---
.mcp.json

# --- runtime data: DB (+ WAL/SHM/backups), logs (any nesting) ---
data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.bak-*
*.log
.tmp/
tmp/

# The `data/` rule above targets the runtime DB dir. Skill data catalogs
# (palettes, font pairings, stack tables) are content and must be committed.
!.claude/skills/*/data/

# --- Python (legacy stack) ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- build output ---
dist/
build/
*.tsbuildinfo
coverage/
apps/web-admin/static/dashboard-app/
apps/storefront/static/shop-app/

# --- Playwright run artifacts (screenshots/traces on failure, HTML report) ---
/test-results/
/playwright-report/
/blob-report/

# --- Prisma generated client (regenerated via prisma generate) ---
**/generated/

# --- local working dirs (audit reports / execution scratch) ---
/execution/
/audit/

# --- git worktrees (isolated workspaces for parallel feature work) ---
/.worktrees/

# --- Playwright MCP scratch output (console logs, page snapshots) ---
/.playwright-mcp/

# --- subagent-driven-development scratch (task briefs, reports, progress ledger) ---
/.superpowers/

# --- graphify auto-update hook scratch (lock dir + run log, see .claude/settings.json) ---
graphify-out/.update.lock
graphify-out/.update.log

# --- graphify dated snapshot dirs are an accidental byproduct of the
#     auto-update hook, not intentional history (~55MB across 5 dirs found
#     2026-08-28) — only the root graphify-out/ contents are meant to be
#     committed. ---
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# --- skill copies the ui-ux-pro-max installer fans out to other agent/editor
#     tools (~4.5 MB each). We use the .claude/skills/ copy; these are noise.
#     (.agents/rules/graphify.md and .agents/workflows/graphify.md are already
#     tracked from before this rule existed and are unrelated legit content —
#     gitignore doesn't apply retroactively, and that's intentional here, not
#     leftover noise to clean up.) ---
/.agents/
/.augment/
/.codebuddy/
/.codewhale/
/.continue/
/.cursor/
/.factory/
/.gemini/
/.github/prompts/
/.kilocode/
/.kiro/
/.opencode/
/.qoder/
/.roo/
/.trae/
/.warp/
/.windsurf/

# --- external/scratch reference docs dumped at repo root (not part of this
#     repo's own docs — keep them local, don't commit) ---
/CHECKOUT-FLOW.md
/trustance-*.md

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
project-design/
gogogo-frontend/

# --- Fase 12 storefront audit screenshots (local QA artifacts, not shipped) ---
capture-storefront/

# Codex isolated development worktrees.
/.worktrees/

# --- pnpm content-addressable store that landed inside the repo (local only) ---
.pnpm-store/

# --- graphify knowledge graph: kept locally for queries, never on origin/master ---
graphify-out/
